{
  "name": "sawaza-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "sawaza.app: the Sawaza marketing site, built with Astro from the approved design.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "build:preview": "PUBLIC_SHOW_ANCHOR=true astro build --outDir dist-preview && node tool/relativize.mjs dist-preview",
    "test:parity": "PUBLIC_SHOW_ANCHOR=true astro build && node tests/parity.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "astro": "6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "pixelmatch": "7.0.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  }
}
