---
/* The phone's status bar with its Dynamic Island: "nt" is the cropped phone's island, "notch" the hero
   phone's, and a pinned screen that shows no bezel has none. The time sits left of the island and the
   signal, Wi-Fi and battery right of it; the kit's .a-sbar draws the icons from the screen's text colour. */
interface Props {
  notch?: 'nt' | 'notch' | 'none';
}
const { notch = 'nt' } = Astro.props;
---
{notch === 'nt' && <span class="nt"></span>}{notch === 'notch' && <div class="notch"></div>}<div class="a-sbar"><span>9:41</span><i></i></div>
