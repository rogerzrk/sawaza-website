---
/* The frame every page sits in: the head, the skip link, the icon sprite, the top bar, the phone
   menu, the footer and the kit script. A page gives its title, description and body id and fills
   <main>; a page with a question rail puts it in the "rail" slot so it sits between the menu and
   the main, where the design draws it. The claim and invite landings use the minimal chrome: a bar
   with the lockup alone and a footer with the legal line alone. */
import '@fontsource/outfit/latin-500.css';
import '@fontsource/outfit/latin-600.css';
import '@fontsource/outfit/latin-700.css';
import '@fontsource/outfit/latin-800.css';
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import '@fontsource/caveat/latin-600.css';
import '@fontsource/caveat/latin-700.css';
import '../styles/kit.css';
import Sprite from '../components/Sprite.astro';
import Lockup from '../components/Lockup.astro';
import { SITE, SITE_NAME, COMPANY, CONTACT_EMAIL } from '../config';

interface Props {
  title: string;
  description: string;
  /** The body id the page's own CSS is scoped under, such as "page-trust". Home has none. */
  bodyId?: string;
  /** The lockup-only bar and legal-only footer of the claim and invite landings. */
  minimal?: boolean;
  /** Keeps a page out of search results: the not-found page, which is no page to find. */
  noindex?: boolean;
}
const { title, description, bodyId, minimal = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/index\.html$|\.html$/, ''), SITE).href;
// One card for every page: the site's mark and line, rendered by tool/og.mjs.
const ogImage = new URL('/og.png', SITE).href;
const nav = [
  ['/how-it-works', 'How it works'],
  ['/groups', 'For groups'],
  ['/businesses', 'For businesses'],
  ['/trust', 'Trust'],
  ['/help', 'Help'],
  ['/about', 'About'],
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#0A1A3D">
{noindex && <meta name="robots" content="noindex">}
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta property="og:type" content="website">
<meta property="og:site_name" content={SITE_NAME}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Sawaza: the record both sides keep">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<slot name="head" />
</head>
<body id={bodyId}>
<a class="skip" href="#main">Skip to content</a>
<Sprite />

{minimal ? (
<header class="claim-head"><div class="wrap"><a href="/" aria-label="Sawaza home"><Lockup /></a></div></header>
) : (
<Fragment>
<header class="site-nav"><div class="wrap">
  <a href="/" aria-label="Sawaza home"><Lockup /></a>
  <nav class="links" aria-label="Main">{nav.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
  <a class="btn btn-gold" href="/#get">Get the app</a>
  <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="msheet"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
</div></header>
<div class="msheet" id="msheet" hidden><div class="mpanel" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="mtop"><a href="/" aria-label="Sawaza home"><Lockup /></a><button class="menu-btn mclose" type="button" aria-label="Close menu" style="display:inline-flex"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
  <nav class="mbig" aria-label="Menu links">{nav.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
  <nav class="msmall" aria-label="Company"><a href="/privacy">Privacy</a><a href="/terms">Terms</a></nav>
  <a class="btn btn-gold" href="/#get">Get the app</a>
</div></div>
</Fragment>
)}

<slot name="rail" />

<main id="main">
<slot />
</main>

{minimal ? (
<footer><div class="wrap">
  <div class="legal"><span>© 2026 {COMPANY}</span><span>sawaza.app</span></div>
</div></footer>
) : (
<footer><div class="wrap">
  <div class="cols">
    <div><Lockup /><p class="money">Sawaza holds no funds and moves no money.</p></div>
    <div><p class="fh">Sawaza</p><ul><li><a href="/how-it-works">How it works</a></li><li><a href="/groups">Groups</a></li><li><a href="/businesses">Businesses</a></li><li><a href="/trust">Trust</a></li></ul></div>
    <div><p class="fh">Company</p><ul><li><a href="/about">About</a></li><li><a href="/help">Help</a></li><li><span>{CONTACT_EMAIL}</span></li></ul></div>
    <div><p class="fh">Legal</p><ul><li><a href="/privacy">Privacy</a></li><li><a href="/terms">Terms</a></li></ul></div>
  </div>
  <div class="legal"><span>© 2026 {COMPANY}</span><span>sawaza.app</span></div>
</div></footer>
)}

<script>
  import '../scripts/kit';
</script>
</body>
</html>
