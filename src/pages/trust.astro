---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import Mark from '../components/Mark.astro';
import PhoneCrop from '../components/PhoneCrop.astro';
import AppBar from '../components/AppBar.astro';
import RecordCard from '../components/RecordCard.astro';
import SectionHead from '../components/SectionHead.astro';
import TLink from '../components/TLink.astro';
import { SHOW_ANCHOR } from '../config';
---
<Base title="Trust and privacy · Sawaza" description="Who signs what, who sees your records, how a signed record stays true, and what Sawaza never does with your money or your data." bodyId="page-trust">
<Fragment slot="rail">
<Rail items={[['top', 'Why trust it?'], ['who-sees', 'Who sees my records?'], ['signing', 'Who signs what?'], ['change', 'What stays true?'], ['number', 'What about my number?']]} />
</Fragment>
<style is:global>
/* Trust and privacy: who signs, who sees, what stays true. Built from kit tokens and the home's app drawings. */
#page-trust .tr-hero{min-width:0;display:grid;justify-items:center}
#page-trust .tr-hero .diagram{max-width:500px}
#page-trust .tr-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:clamp(32px,6vw,88px);align-items:center}
#page-trust .tr-grid.flip>.tr-vis{order:-1}
#page-trust .tr-grid .sec-head{margin-bottom:0}
#page-trust .tr-vis{display:grid;justify-items:center;gap:18px;min-width:0}
#page-trust .facts{margin-top:28px}
#page-trust .facts li{align-items:start}
#page-trust .facts li span{line-height:1.5}
#page-trust .ink{color:var(--ink)}

#page-trust .tr-card{font-size:12.5px;border-radius:16px;background:#0F1219;border:1px solid #2A303C;padding:.3em 0;box-shadow:0 24px 50px -30px rgba(0,0,0,.9);width:100%;max-width:360px}
#page-trust .tr-pad{padding:.4em 0 1.2em}
#page-trust .tr-pad .a-sec{padding-top:.6em}
#page-trust .a-rf .ne{font:700 1.2em/1 var(--body);color:var(--a-clay)}
#page-trust .a-rf .cl{color:var(--a-clay)}
#page-trust .a-rf .qt{color:var(--a-quiet)}
#page-trust .tr-line{font:600 14px/1.4 var(--body);text-align:center}
#page-trust .tr-line .cl{color:#E88A76}

#page-trust .tr-who{list-style:none;margin:0;padding:0;width:100%;max-width:360px;display:grid}
#page-trust .tr-who li{display:flex;justify-content:space-between;gap:12px;padding:10px 2px;border-top:1px solid var(--line);font-size:14.5px}
#page-trust .tr-who li:last-child{border-bottom:1px solid var(--line)}
#page-trust .tr-who span{color:var(--dim)}
#page-trust .tr-who b{color:var(--ink);font-weight:600;text-align:right}

#page-trust .tr-quote{margin-top:28px;padding:18px 20px;border-left:2px solid var(--gold);background:rgba(255,255,255,.03);border-radius:0 12px 12px 0;color:var(--ink);font-size:clamp(16px,1.6vw,18px);line-height:1.55;max-width:32em}
#page-trust .tr-body{margin-top:24px;color:var(--dim);font-size:clamp(16px,1.6vw,18px);line-height:1.6;max-width:34em}

#page-trust .tr-paper{font-size:13px;width:100%;max-width:340px;background:none;padding:0}
#page-trust .tr-paper .a-cert{margin:0;box-shadow:0 30px 60px -28px rgba(0,0,0,.9)}

#page-trust .tr-cc{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(16px,2.4vw,28px)}
#page-trust .tr-col{border-radius:22px;background:var(--panel);border:1px solid var(--line);padding:clamp(22px,3vw,32px)}
#page-trust .tr-col.no{border-color:rgba(255,255,255,.22)}
#page-trust .tr-col .lbl{margin-bottom:14px}
#page-trust .tr-col.yes .lbl{color:var(--gold)}
#page-trust .tr-col.no .lbl{color:var(--ink)}
#page-trust .tr-col ul{list-style:none;margin:0;padding:0;display:grid}
#page-trust .tr-col li{padding:14px 0 14px 30px;border-top:1px solid var(--line);color:var(--ink);font-size:16.5px;line-height:1.45;position:relative}
#page-trust .tr-col li::before{content:"";position:absolute;left:4px;top:21px;width:10px;height:10px;border-radius:50%;border:2px solid var(--gold)}
#page-trust .tr-col.no li::before{border-color:var(--ink);border-radius:2px;transform:rotate(45deg)}

#page-trust .tr-flow{padding:clamp(24px,4vw,40px) 18px;border-radius:22px;background:linear-gradient(160deg,#1A2E63,#0E1E47 70%);border:1px solid rgba(227,168,43,.35)}

#page-trust .tr-short .hscreen{height:44em}
#page-trust .tr-door{padding:0 1.6em;display:flex;flex-direction:column}
#page-trust .tr-door .a-sbar{margin:0 -1.6em}
#page-trust .d-lock{margin:2.6em auto 0;width:10em}
#page-trust .d-lock .lockup{width:100%;height:auto;display:block;color:#EDE8DE}
#page-trust .d-tag{text-align:center;margin-top:.9em;font-size:.875em;color:var(--a-dim)}
#page-trust .d-marks{display:flex;gap:.4em;justify-content:center;margin-top:2em}
#page-trust .d-marks i{width:1.6em;height:.3em;border-radius:1em;background:var(--a-line)}
#page-trust .d-marks i.on{background:#E3A82B}
#page-trust .d-h{margin-top:1.8em;font:700 1.5em/1.2 var(--display);color:var(--a-text)}
#page-trust .d-b{margin-top:.6em;font-size:.95em;line-height:1.45;color:var(--a-dim)}
#page-trust .d-f{margin-top:1em;display:grid;gap:.4em}
#page-trust .d-f small{font:700 .75em/1 var(--body);letter-spacing:.05em;text-transform:uppercase;color:var(--a-dim)}
#page-trust .d-f div{display:flex;align-items:center;gap:.6em;height:3.4em;padding:0 .9em;border-radius:.75em;background:var(--a-surface);border:1px solid var(--a-line)}
#page-trust .d-f b{flex:1;font:500 1.05em/1 var(--body);color:var(--a-text)}
#page-trust .d-f em{font-style:normal;color:var(--a-dim)}
#page-trust .d-f svg.i{width:1.2em;height:1.2em;color:var(--a-dim)}
#page-trust .tr-door .a-btn{margin-top:1.6em}
#page-trust .d-n{margin-top:.8em;text-align:center;font-size:.875em;color:var(--a-dim)}

#page-trust .tr-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
#page-trust .tr-c{border-radius:20px;background:var(--panel);border:1px solid var(--line);padding:22px;display:grid;gap:10px;align-content:start}
#page-trust .tr-c h3{font-size:19px;font-weight:600;line-height:1.3;color:var(--ink)}
#page-trust .tr-c p{color:var(--dim);font-size:15.5px;line-height:1.55}
#page-trust .tr-more{margin-top:28px}
#page-trust .plate{margin-top:28px}
#page-trust .tr-co{display:grid;gap:clamp(28px,4vw,44px);max-width:680px}
#page-trust .next-col{align-self:end}
#page-trust .next-col .next-row{margin-top:14px}

@media (max-width:1000px){#page-trust .tr-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:899px){
  #page-trust .tr-grid{grid-template-columns:minmax(0,1fr)}
  #page-trust .tr-grid.flip>.tr-vis{order:0}
}
@media (max-width:640px){#page-trust .tr-cc,#page-trust .tr-cards{grid-template-columns:minmax(0,1fr)}}
@media (max-width:420px){#page-trust .hphone{font-size:11.6px}#page-trust .tr-who li{font-size:13.5px}}

#page-trust .facts svg{color:var(--gold)}
#page-trust .tlink{min-height:44px}
@media (min-width:900px){
  #page-trust .tr-vis{align-self:stretch;align-content:center}
  #page-trust .tr-card{max-width:520px;font-size:clamp(14px,1.25vw,17px)}
  #page-trust .tr-who{max-width:520px;font-size:16px}
  #page-trust .tr-who li{font-size:16px}
  #page-trust .tr-line{font-size:16px}
}
#page-trust .tr-single{max-width:760px}
#page-trust .tr-money{margin-top:clamp(28px,4vw,44px)}
#page-trust .next-row{margin-top:28px}
#page-trust .tr-chain{margin-top:clamp(28px,4vw,44px);max-width:44em;color:var(--dim);font-size:clamp(16px,1.6vw,18px);line-height:1.6;display:grid;gap:6px;justify-items:start}
</style>
<section class="page-hero" id="top">
  <Mark class="watermark" />
  <div class="wrap split">
    <div>
      <p class="q">Why trust it?</p>
      <h1>Who signs what, and what can't <em>change quietly.</em></h1>
      <p class="sub" data-new="1">Each side signs the same record on their own phone. Sawaza shows it only to the people you choose, and it never holds or moves your money.</p>
    </div>
    <div class="tr-hero"><svg class="diagram" viewBox="0 0 520 300" role="img" aria-label="Each side signs on their own phone, and the two signatures make one sealed record.">
        <defs><radialGradient id="sg" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#5CD6D6" stop-opacity=".35"/><stop offset="1" stop-color="#5CD6D6" stop-opacity="0"/></radialGradient></defs>
        <g fill="none" stroke="rgba(237,232,222,.35)" stroke-width="1.5">
          <rect x="30" y="60" width="96" height="180" rx="18"/><rect x="394" y="60" width="96" height="180" rx="18"/>
        </g>
        <g fill="none" stroke="#E3A82B" stroke-width="2" stroke-linecap="round">
          <path d="M52 170c8-12 12-14 14-7s-2 10 4 3 8-12 10-5 4 8 14 0"/>
          <path d="M416 170c8-12 12-14 14-7s-2 10 4 3 8-12 10-5 4 8 14 0"/>
        </g>
        <g fill="rgba(237,232,222,.55)"><rect x="50" y="96" width="56" height="6" rx="3"/><rect x="50" y="110" width="40" height="6" rx="3"/><rect x="414" y="96" width="56" height="6" rx="3"/><rect x="414" y="110" width="40" height="6" rx="3"/></g>
        <path d="M126 150C190 150 200 150 236 150M394 150C330 150 320 150 284 150" fill="none" stroke="#5CD6D6" stroke-width="1.6" stroke-dasharray="4 6"/>
        <circle cx="260" cy="150" r="70" fill="url(#sg)"/>
        <circle cx="260" cy="150" r="34" fill="#0A1A3D" stroke="rgba(237,232,222,.18)" stroke-width="1.5"/>
        <use href="#i-ver" x="236" y="126" width="48" height="48" style="color:#E3A82B"/>
        <text x="78" y="268" text-anchor="middle" fill="#939CB1" font-size="13" font-family="Plus Jakarta Sans, sans-serif">Sarah signs</text>
        <text x="442" y="268" text-anchor="middle" fill="#939CB1" font-size="13" font-family="Plus Jakarta Sans, sans-serif">David signs</text>
        <text x="260" y="214" text-anchor="middle" fill="#5CD6D6" font-size="15" font-weight="600" font-family="Plus Jakarta Sans, sans-serif">Sawa. Sealed.</text>
      </svg></div>
  </div>
</section>

<!-- Who sees what -->
<section class="sec deep" id="who-sees"><div class="wrap">
  <div class="tr-grid">
    <div>
      <SectionHead q="Who sees my records?" title="Only the people you choose." titleNew><p class="lede">A record you write stays yours until you send it, and you never have to.</p></SectionHead>
      <ul class="facts">
        <li><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="6" y="12" width="16" height="12" rx="2.5"/><path d="M9.5 12V9a4.5 4.5 0 0 1 9 0v3"/></svg><span data-new="1">A record you keep for yourself is seen by you alone.</span></li>
        <li><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="9" cy="11" r="3.5"/><circle cx="19" cy="11" r="3.5"/><path d="M3 23c0-4 2.7-6 6-6s6 2 6 6M13 23c0-4 2.7-6 6-6s6 2 6 6"/></svg><span data-new="1">A record you send is seen by you and the person you sent it to.</span></li>
        <li><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="5" width="20" height="18" rx="5"/><path d="M9 13h10M9 17h6"/></svg><span data-new="1">In a group, every member reads the group's records.</span></li>
        <li><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M17 4H8a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M17 4v5h5"/></svg><span data-new="1">A photo or receipt you attach is read only by the people who can read its record.</span></li>
      </ul>
    </div>
    <div class="tr-vis" role="img" aria-label="Three records and who can see each: Groceries, you alone; Boda-boda with Peter, you alone until you share it; Rent with David, you and David.">
      <PhoneCrop h="430px"><AppBar wordmark />
        <RecordCard solo item="Groceries" dir="out" amount="UGX 35,000" label="Expense · 8:05 am" />
        <RecordCard initials="PE" name="Peter" time="9:40 am" label="You lent" item="Boda-boda" dir="out" amount="UGX 50,000" status="only-you" />
        <RecordCard who="david" name="David Landlord" time="1 Oct" label="You paid" item="Rent" dir="out" amount="UGX 450,000" status="sealed" />
      </PhoneCrop>
      <ul class="tr-who">
        <li><span>Groceries</span><b data-new="1">You alone</b></li>
        <li><span>Boda-boda with Peter</span><b data-new="1">You alone, until you share it</b></li>
        <li><span>Rent with David</span><b data-new="1">You and David</b></li>
      </ul>
    </div>
  </div>
</div></section>

<!-- Signing -->
<section class="sec" id="signing"><div class="wrap"><div class="tr-single">
  <SectionHead q="Who signs what?" title="Each side signs on their own phone."><p class="lede" data-new="1">Sarah signs when she writes the record. David signs when he confirms it, on his own phone. A record is sealed only when everyone it names has signed, so everyone is on the same page. If they disagree, both versions are kept: Sawaza is a witness, not a judge.</p><p class="lede" data-new="1">Every record keeps its history: who wrote it, who answered it and when, and every change is shown.</p></SectionHead>
</div></div></section>

<!-- Nobody can change it, no money -->
<section class="sec deep" id="change"><div class="wrap">
  <SectionHead q="What stays true?" title="A signed record can't change quietly. Nobody touches your money." titleNew><p class="lede" data-new="1">Sawaza never holds or moves money. It keeps the record of it.</p></SectionHead>
  <div class="tr-cc">
    <div class="tr-col yes">
      <p class="lbl" data-new="1">You can</p>
      <ul>
        <li data-new="1">Remove your own copy, never the other side's.</li>
        <li data-new="1">File it your own way: its item, its space, its account.</li>
      </ul>
    </div>
    <div class="tr-col no">
      <p class="lbl" data-new="1">What stays true</p>
      <ul>
        <li data-new="1">A record is sealed once it is signed, so any change shows.</li>
        <li data-new="1">The other side's copy stays theirs.</li>
        <li data-new="1">A disagreement keeps both versions.</li>
      </ul>
    </div>
  </div>
{SHOW_ANCHOR && (
  <p class="tr-chain" data-new="1">Each sealed record is also time-stamped on Stellar, a public blockchain we don't control, so anyone holding a copy can check it hasn't changed. <TLink href="/verify" label="Check a record yourself" /></p>
)}
  <ul class="facts tr-money">
        <li><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="8" width="20" height="13" rx="2.5"/><path d="M4 12h20"/></svg><span data-new="1">You pay in cash, by Mobile Money or through a bank, as you always have. Sawaza keeps the record of it.</span></li>
        <li><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 4l9 4v6c0 5-4 9-9 10-5-1-9-5-9-10V8z"/></svg><span>Sawaza never asks you to send money.</span></li>
        <li><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="14" cy="14" r="9"/><path d="M10 14h8"/></svg><span>Sawaza is free to use: write records, send them and keep them, with no fees.</span></li>
      </ul>
</div></section>

<!-- Number and phonebook -->
<section class="sec" id="number"><div class="wrap"><div class="tr-single">
  <SectionHead q="What about my number?" title="Your number signs. Your phonebook stays on your phone." titleNew />
  <ul class="facts">
    <li><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="8" y="3" width="12" height="22" rx="3"/><path d="M12 21h4"/></svg><span data-new="1">You sign in with your phone number and a six-digit code. Records you make are signed under that number.</span></li>
    <li><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="4" width="18" height="20" rx="3"/><circle cx="14" cy="12" r="3"/><path d="M9 20c1-2.5 3-3.5 5-3.5s4 1 5 3.5"/></svg><span>The names in your phonebook stay on your phone too.</span></li>
    <li><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 4l9 4v6c0 5-4 9-9 10-5-1-9-5-9-10V8z"/></svg><span data-new="1">We do not sell your data, and there are no ads. Deleting your account is in Settings.</span></li>
  </ul>
  <div class="next-row"><TLink href="/privacy" label="Read the privacy policy" /><TLink href="/help" label="Help" /><TLink href="/how-it-works" label="See how it works" /></div>
</div></div></section>
</Base>
