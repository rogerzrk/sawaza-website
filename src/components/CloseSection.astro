---
/* The section every page ends on: the mark, the line, the badges, and on the pages that carry
   them the pull line and the note for someone added to a group. A page's next-page links go in
   the slot. */
import Mark from './Mark.astro';
import StoreBadges from './StoreBadges.astro';
interface Props {
  pull?: boolean;
  added?: boolean;
}
const { pull = false, added = false } = Astro.props;
---
<section class="sec close" id="get"><div class="wrap">
  <Mark class="mark" />
  <h2>Both sides. One record. <span>Signed.</span></h2>
  <p>Your first record takes a minute. Sending it is your call.</p>
  {pull && <p class="get-pull" data-new="1">Put your side on the record. Sawaza is free to use.</p>}
  <StoreBadges />
  {added && <p class="added" data-new="1"><b>Added to a group?</b> Get the app and sign up with the number you were added on. The invitation is waiting there for you to accept or decline.</p>}
  <slot />
</div></section>
