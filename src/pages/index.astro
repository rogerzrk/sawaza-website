---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import Mark from '../components/Mark.astro';
import StoreBadges from '../components/StoreBadges.astro';
import HeroPhone from '../components/HeroPhone.astro';
import PhoneCrop from '../components/PhoneCrop.astro';
import StatusBar from '../components/StatusBar.astro';
import AppBar from '../components/AppBar.astro';
import ContactBar from '../components/ContactBar.astro';
import Tabs from '../components/Tabs.astro';
import Thread from '../components/Thread.astro';
import ConfirmSheet from '../components/ConfirmSheet.astro';
import RecordCard from '../components/RecordCard.astro';
import Avatar from '../components/Avatar.astro';
import SectionHead from '../components/SectionHead.astro';
import TLink from '../components/TLink.astro';
import CloseSection from '../components/CloseSection.astro';
import DoorScreen from '../components/home/DoorScreen.astro';
import DoorCard from '../components/home/DoorCard.astro';
import { PERSONAL_TABS, sarahWithDavid, davidWithSarah } from '../components/threads';
import { SHOW_ANCHOR } from '../config';

/* The hero's two phones carry the ties the thread line is drawn between, and David's October
   figure stays grey until the stage seals it. */
const sarah = sarahWithDavid.map((it) => (it.pending ? { ...it, tie: 'tieA' } : it));
const david = davidWithSarah.map((it) => (it.pending ? { ...it, tie: 'tieB', hold: true } : it));
---
<Base title="Sawaza: the record both sides keep" description="The record both sides keep. Write down money between you and the people you deal with, and both of you sign the same record.">
<Fragment slot="rail">
<Rail items={[['top', 'What is this?'], ['problem', 'Why would I need it?'], ['how', 'How does it work?'], ['doors', 'Is it for me?'], ['trust', 'Why trust it?'], ['get', 'How do I start?']]} />
</Fragment>
<!-- 1 Hero -->
<section class="hero" id="top">
  <Mark class="watermark" />
  <div class="wrap">
    <div>
      <p class="q">In beta in Uganda</p>
      <h1>The record both sides <em>keep.</em></h1>
      <p class="sub">You paid your landlord <b class="num">UGX 450,000</b> for October. Sawaza keeps one record you both sign, so you're always on the same page.</p>
      <div class="cta-row"><StoreBadges class="hero-badges" /></div>
      <ul class="aud" aria-label="Who Sawaza is for" data-new="1"><li><a href="#door-you">Personal</a></li><li><a href="#door-grp">Groups</a></li><li><a href="#door-biz">Businesses</a></li></ul>
    </div>
    <div class="stage-col">
    <div class="stage sealed" id="stage" role="img" aria-label="Sarah's thread with David and David's thread with Sarah, each holding the same October rent record. David confirms it and both phones show it sealed.">
      <div class="ph-wrap">
        <p class="who">Sarah's phone</p>
        <HeroPhone><ContactBar who="david" name="David Landlord" sub="On Sawaza · +256 772 410 118" /><Tabs tabs={PERSONAL_TABS} /><Thread heads={['David Landlord', 'You']} items={sarah} fab /></HeroPhone>
      </div>
      <div class="ph-wrap">
        <p class="who">David's phone</p>
        <HeroPhone><ContactBar who="sarah" name="Sarah" sub="On Sawaza · +256 701 552 093" /><Tabs tabs={PERSONAL_TABS} /><Thread heads={['Sarah', 'You']} items={david} fab /><ConfirmSheet hero /></HeroPhone>
      </div>
      <svg class="thread" id="thread" aria-hidden="true"><path id="threadPath" d=""/><circle id="tA" r="3.5"/><circle id="tB" r="3.5"/></svg>
    </div>
      <p class="chip-cap"><span class="cc"><svg class="cver" aria-hidden="true"><use href="#i-ver"/></svg><span data-new="1"><b>Sawa. Sealed.</b> means you both confirmed it.</span></span><button class="hpause" id="hpause" type="button" aria-label="Pause animation" hidden><svg class="ic-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg><svg class="ic-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></button></p>
    </div>
  </div>
</section>

<!-- 2 Problem -->
<section class="sec problem deep ruled" id="problem"><div class="wrap">
  <div class="grid">
    <div class="book reveal" aria-label="The landlord's rent book. August, September and November are written in. October is blank.">
      <div class="page">
        <div class="page-h"><span>Rent book</span><span>Sarah, House 4</span></div>
        <div class="entry"><span class="m">Aug</span><span>450,000</span><span class="tick">✓</span></div>
        <div class="entry"><span class="m">Sep</span><span>450,000</span><span class="tick">✓</span></div>
        <div class="entry missing"><span class="m">Oct</span><span></span><span></span></div>
        <div class="entry"><span class="m">Nov</span><span>450,000</span><span class="tick">✓</span></div>
        <div class="entry"><span class="m">Dec</span><span></span><span></span></div>
        <div class="page-sign"><span>Landlord's hand</span>
          <svg viewBox="0 0 84 30" aria-hidden="true"><path d="M3 22c8-14 12-16 14-8s-2 12 4 4 8-14 10-6 4 10 12 2 10-6 14-2 8 8 22-6" fill="none" stroke="#22408C" stroke-width="2" stroke-linecap="round"/></svg></div>
      </div>
      <span class="note-q" aria-hidden="true">?</span>
    </div>
    <div>
      <SectionHead q="Why would I need it?" title="Your money took work. Give it a proper signed record." titleNew style="margin-bottom:0"><p class="lede" data-new="1">You'd never buy land without a signed agreement. Why lend school fees without one?</p></SectionHead>
      <figure class="said" data-new="1">
        <blockquote>&ldquo;You say you paid for October, but I don&rsquo;t have it in my book.&rdquo;</blockquote>
        <figcaption>Your landlord, in December.</figcaption>
      </figure>
      <p class="lede" style="margin-top:22px;color:var(--ink);font-weight:600">Whoever keeps the book keeps the history.</p>
    </div>
  </div>

  <p class="lbl" style="margin-top:clamp(56px,7vw,88px)">What people use today</p>
  <div class="today2">
    <div class="obj2"><div class="art" aria-hidden="true"><span class="unsigned">Unsigned</span><div class="nb"><p>David 450k</p><p>Oct, cash</p><p>Nov, cash</p></div></div><p class="nm">A notebook</p></div>
    <div class="obj2"><div class="art" aria-hidden="true"><span class="unsigned">Unsigned</span><div class="mini-wa">Sent the October rent to you<small>10:21 ✓✓</small></div></div><p class="nm">A WhatsApp message</p></div>
    <div class="obj2"><div class="art" aria-hidden="true"><span class="unsigned">Unsigned</span><div class="cloud">I think I paid him&hellip;</div></div><p class="nm">Memory</p></div>
    <div class="obj2"><div class="art" aria-hidden="true"><span class="unsigned">Unsigned</span><div class="sms"><b>MOBILE MONEY</b>You have sent UGX 450,000 to DAVID J. on 01/10/2026.</div></div><p class="nm">A Mobile Money SMS</p></div>
  </div>
  <p class="today-cap" data-new="1">A notebook, a message and memory are written by one side. A Mobile Money SMS comes from the network. Neither of you signed any of them.</p>

  <p class="closer-line">Only one side ever gets to write it down. <span data-new="1">With Sawaza, both sides hold it, signed.</span></p>
</div></section>

<!-- 3 How it works -->
<section class="sec" id="how"><div class="wrap">
  <SectionHead q="How does it work?" title="From a payment to a sealed record, in four steps." />
  <div class="how">
    <div class="how-stick" aria-hidden="true"><div class="hphone"><div class="hscreen" id="howScreen"></div></div><ol class="how-dots"><li class="on"></li><li></li><li></li><li></li></ol></div>
    <ol class="hsteps">
      <li class="hstep" data-step="1">
        <div class="shot" aria-hidden="true"><PhoneCrop h="272px" y="0px" dataS="1">
  <AppBar wordmark avatar="sarah" />
  <div class="a-ov"><div class="a-ovh">THIS MONTH<span>UGX</span></div><div class="a-ovc"><div><small>Money in</small><b class="in num">0</b></div><div><small>Money out</small><b class="out num">35,000</b></div></div></div>
  <div class="a-scrim"></div>
  <div class="a-sheet"><i class="a-grab"></i>
    <div class="a-sht"><b>New record</b><svg class="i"><use href="#i-x"/></svg></div>
    <div class="a-body">
      <div class="a-dir"><span class="a-dp on-out"><svg class="i"><use href="#i-up"/></svg>I paid</span><span class="a-dp"><span class="n" style="display:flex"><svg class="i"><use href="#i-down"/></svg></span>I received</span><i class="a-vd"></i><span class="a-dp more">More<svg class="i"><use href="#i-cd"/></svg></span></div>
      <div class="a-f"><div class="a-cap">AMOUNT <em>Required</em></div><div class="a-amt out num">450,000</div></div>
      <div class="a-f"><div class="a-cap">WHO <em class="opt">optional</em></div><div class="a-party"><Avatar who="david" size="s28" /><div><b>David Landlord</b><small>On Sawaza</small></div><svg class="i x"><use href="#i-x"/></svg></div></div>
      <div class="a-f"><div class="a-cap">WHAT WAS IT?</div><div class="a-val"><span>Rent</span><span class="a-pillc">Items</span></div></div>
      <div class="a-f a-goes"><div><div class="a-cap">PAID FROM</div><b>Mobile money</b></div><svg class="i"><use href="#i-cr"/></svg></div>
      <p class="a-attach">Attach a receipt or photo</p>
    </div>
    <div class="a-foot">
      <div class="a-share"><svg class="i"><use href="#i-ppl"/></svg><div><b>Send to David Landlord</b><small>They will be asked to confirm it</small></div><span class="a-sw"></span></div>
      <span class="a-btn">Record and send</span>
    </div>
  </div>
</PhoneCrop></div>
        <div class="htext">
          <p class="hn"><i>1</i>On Sarah's phone</p>
          <h3>Write it.</h3>
          <p>Who, how much and what for. A phone contact, a number, or just a name.</p>
        </div>
      </li>
      <li class="hstep" data-step="2">
        <div class="shot" aria-hidden="true"><PhoneCrop h="342px" y="0px" app="a-wall" dataS="2">
  <p class="a-clock num">10:22</p><p class="a-date">Thursday, 1 October</p>
  <div class="a-note"><div class="ap"><Mark gold /><span>Sawaza · now</span></div><b>Sarah recorded a payment with you</b><p>UGX 450,000 · Rent</p><p class="act">Confirm it</p></div>
</PhoneCrop></div>
        <div class="htext">
          <p class="hn"><i>2</i>On David's phone</p>
          <h3>Send it.</h3>
          <p>They get it in Sawaza, or a link if they are not on it yet. <strong>Don't wait for their book. Start yours.</strong></p>
        </div>
      </li>
      <li class="hstep" data-step="3">
        <div class="shot" aria-hidden="true"><PhoneCrop h="325px" fromBottom dataS="3">
  <AppBar wordmark avatar="david" />
  <RecordCard wash who="sarah" name="Sarah" time="10:21 am" label="Paid you" item="Rent" dir="in" amount="UGX 450,000" status="awaiting-you" />
  <ConfirmSheet />
</PhoneCrop></div>
        <div class="htext">
          <p class="hn"><i>3</i>On David's phone</p>
          <h3>They answer.</h3>
          <p>Confirm, “The details are wrong”, or “This isn't mine”. If you still disagree, both versions are kept. <strong>Sawaza is a witness, not a judge.</strong></p>
        </div>
      </li>
      <li class="hstep" data-step="4">
        <div class="shot" aria-hidden="true"><PhoneCrop h="300px" y="0px" dataS="4">
  <AppBar title="Record" back icons={['share', 'more']} />
  <div class="a-cert">
    <div class="hd"><span><Mark gold />Sawaza</span><em>RECORD · A1B2 C3D4</em></div>
    <p class="it">Rent</p>
    <p class="am num"><small>UGX</small>450,000</p>
    <p class="wd">Four hundred and fifty thousand shillings</p>
    <p class="se">Sarah paid David</p>
    <p class="hp">Paid on 1 Oct 2026</p>
    <div class="a-sig">
      <div class="col"><Avatar who="sarah" /><b>+256 701 552 093</b><small>On Sawaza</small><span>Sarah</span><small>Self-declared</small></div>
      <div class="vb">paid<svg viewBox="0 0 36 10" aria-hidden="true"><path d="M1 5h33M28 1l6 4-6 4" fill="none" stroke="#0D7373" stroke-width="1.6"/></svg></div>
      <div class="col"><Avatar who="david" /><b>+256 772 410 118</b><small>On Sawaza</small><span>David</span><small>Self-declared</small></div>
    </div>
    <p class="hl2">Recorded by Sarah<br>Confirmed by David</p>
    <p class="seal">Sealed · both sides hold this record, signed</p>
    <p class="fp">Signed · 3FA9 1C0E</p>
    <div class="dr"></div>
  </div>
  <p class="a-sec">HISTORY</p>
  <div class="a-rungs">
    <div class="a-rung"><i></i><div><b>You recorded it</b><span>Signed on this phone when it was written</span><span>1 Oct 2026, 10:21 am</span></div></div>
    <div class="a-rung"><i class="g"></i><div><b>David Landlord confirmed it</b><span>Signed on their phone, the same record</span><span>1 Oct 2026, 10:24 am</span></div></div>
    <div class="a-rung"><i class="t"></i><div><b>Sealed</b><span>Both of you signed the same record.</span></div></div>
  </div>
</PhoneCrop></div>
        <div class="htext">
          <p class="hn"><i>4</i>On both phones</p>
          <h3 class="h-seal"><svg class="cver" aria-hidden="true"><use href="#i-ver"/></svg><span>Sawa. Sealed.</span></h3>
          <p data-new="1">You both signed. You both hold the same copy, on the same page.</p>
          <div class="side" aria-hidden="true"><div class="app" style="max-width:340px">
  <RecordCard who="sarah" name="Sarah" time="1 Oct" label="Paid you" item="Rent" dir="in" amount="UGX 450,000" status="sealed" />
</div></div>
        </div>
      </li>
    </ol>
  </div>
  <p class="after-steps"><TLink href="/how-it-works" label="See how it works" /></p>
</div></section>

<!-- 4 Doors -->
<section class="sec ruled" id="doors"><div class="wrap">
  <SectionHead q="Is it for me?" title="Made for the money you already share."><p class="fm3-intro">Sarah’s October, in three records.</p></SectionHead>
  <div class="fm3-pin">
    <div class="fm3-blocks">
      <article class="fm3-blk on" data-k="you" id="door-you">
        <div class="fm3-hd"><p class="fm3-tag">Personal</p><h3 class="fm3-title">You and the people you deal with</h3><p class="fm3-cap"><span class="when">12 Oct</span><span data-new="1">Sarah lends Grace school fees.</span></p></div>
        <div class="fm3-vis" aria-hidden="true"><p class="lab">Sarah’s phone · Grace</p><div class="fm3-ph"><PhoneCrop h="340px" fade="94%" app="thr"><DoorScreen k="you" /></PhoneCrop></div><DoorCard k="you" /></div>
        <div class="fm3-bd"><p class="fm3-line">Bill, lend, pay and buy, with a record you both sign.</p><p class="fm3-in" data-new="1">Inside: your records, debts, accounts, the things you own, and your books.</p><TLink href="/how-it-works" label="See how it works" /></div>
      </article>
      <article class="fm3-blk fm3-grp" data-k="grp" id="door-grp">
        <div class="fm3-hd"><p class="fm3-tag">Group</p><h3 class="fm3-title">The money you keep together</h3><p class="fm3-cap"><span class="when">12 Oct</span>Kisaasi Savers records her savings.</p></div>
        <div class="fm3-vis" aria-hidden="true"><p class="lab">Kisaasi Savers · Register</p><div class="fm3-ph"><PhoneCrop h="285px" app="tight"><DoorScreen k="grp" /></PhoneCrop></div><DoorCard k="grp" /></div>
        <div class="fm3-bd"><p class="fm3-line">One record for the whole group. Each member confirms their own part.</p><p class="fm3-in" data-new="1">Inside: households, savings groups and SACCOs, and cash rounds, with a register and a passbook for each member.</p><TLink href="/groups" label="For groups" /></div>
      </article>
      <article class="fm3-blk fm3-biz" data-k="biz" id="door-biz">
        <div class="fm3-hd"><p class="fm3-tag">Business</p><h3 class="fm3-title">Your trade and hustle</h3><p class="fm3-cap"><span class="when">31 Oct</span>Mukasa Traders bills her.</p></div>
        <div class="fm3-vis" aria-hidden="true"><p class="lab">Mukasa Traders’ phone · Sarah</p><div class="fm3-ph"><PhoneCrop h="285px" app="tight"><DoorScreen k="biz" /></PhoneCrop></div><DoorCard k="biz" /></div>
        <div class="fm3-bd"><p class="fm3-line">Invoices and credit your customers can sign for.</p><p class="fm3-in" data-new="1">Inside: customer accounts, invoices and loans, and your books, each kept apart from your own money.</p><TLink href="/businesses" label="For businesses" /></div>
      </article>
    </div>
    <div class="fm3-stick" aria-hidden="true"><p class="lab" id="fm3Lab">Sarah’s phone · Grace</p>
      <div class="fm3-dev"><div class="fm3-scr on" data-k="you"><div class="app thr"><StatusBar notch="none" /><DoorScreen k="you" /></div></div><div class="fm3-scr" data-k="grp"><div class="app tight"><StatusBar notch="none" /><DoorScreen k="grp" /></div></div><div class="fm3-scr" data-k="biz"><div class="app tight"><StatusBar notch="none" /><DoorScreen k="biz" /></div></div></div>
      <div class="fm3-sums"><div class="fm3-sum on" data-k="you"><DoorCard k="you" /></div><div class="fm3-sum" data-k="grp"><DoorCard k="grp" /></div><div class="fm3-sum" data-k="biz"><DoorCard k="biz" /></div></div>
    </div>
  </div>
  <p class="fm3-rest" data-new="1">These are the first tools in the app. More are on the way, for each kind of relationship.</p>
</div></section>

<!-- 5 Before you ask, and why trust it -->
<section class="sec deep trust" id="trust"><div class="wrap">
  <SectionHead q="Why trust it?" title="Before you ask." />
  <div class="asks2">
    <article class="ak money reveal">
      <div class="ak-art" aria-hidden="true"><div class="flow">
        <span class="p"><i class="ph ph-sarah">SA</i>Sarah</span>
        <span class="mv"><span class="note num">450,000</span></span>
        <span class="p"><i class="ph ph-david">DA</i>David Landlord</span>
        <div class="flow-tags"><span>Cash or mobile money</span></div>
        <div class="flow-rec"><svg class="fver" aria-hidden="true"><use href="#i-ver"/></svg><span><b>Rent · UGX 450,000</b><small>Sarah paid David</small><em>Sealed · both sides hold this record, signed</em></span></div>
      </div></div>
      <div class="ak-t"><h3>Does Sawaza touch my money?</h3><p class="no">No.</p><p class="ans">It records money. It never holds it or moves it.</p></div>
    </article>
    <div class="ak-list">
      <div class="akl reveal"><span class="akl-i" aria-hidden="true"><svg class="i"><use href="#i-share"/></svg></span><div><h3>Why would the other person sign?</h3><p class="ans" data-new="1">They get a message that opens the record in the app, where they answer it. A signed record protects them too.</p></div></div>
      <div class="akl reveal"><span class="akl-i" aria-hidden="true"><svg class="i fill"><use href="#i-lock"/></svg></span><div><h3>Who sees my records?</h3><p class="ans">Only the people you choose to share them with. You can write a record about someone and keep it to yourself: it stays private until you send it, and you never have to.</p></div></div>
      <div class="akl reveal"><span class="akl-i akl-zero num" aria-hidden="true">UGX 0</span><div><h3>What does it cost?</h3><p class="ans">Sawaza is free to use: write records, send them and keep them, with no fees.</p></div></div>
    </div>
  </div>
  <ul class="facts facts-row">
      <li><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="8" y="3" width="12" height="22" rx="3"/><path d="M11 17c2-3 3-3 3-1s1 2 3-1"/></svg>Each side signs on their own phone.</li>
      <li><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="6" y="12" width="16" height="12" rx="2.5"/><path d="M9.5 12V9a4.5 4.5 0 0 1 9 0v3"/></svg>A signed record is sealed, so any change shows. A disagreement keeps both versions.</li>
{SHOW_ANCHOR && (
      <li data-new="1"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><use href="#i-ver"/></svg><span>Each sealed record is also time-stamped on Stellar, a public blockchain we don't control, so anyone holding a copy can check it hasn't changed. <TLink href="/verify" label="Check a record yourself" /></span></li>
)}
      <li><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="7" width="12" height="16" rx="2"/><rect x="13" y="5" width="12" height="16" rx="2" fill="#060F26"/><path d="M7 13h4M17 11h4M17 15h4"/></svg>You can remove your own copy, never the other side's.</li>
  </ul>
  <p class="plate-line">Made in Kampala by <strong>SAWAZA TECHNOLOGIES - SMC LIMITED</strong>, in beta on Android and iPhone. <TLink href="/trust" label="Trust and privacy" /></p>
</div></section>

<!-- 6 Close -->
<CloseSection pull added />
<script>
(function(){
  requestAnimationFrame(function(){drawThread()});

  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches,narrow=window.matchMedia('(max-width:700px)');
  var stage=document.getElementById('stage');
  function drawThread(){
    var ta=document.getElementById('tieA'),tb=document.getElementById('tieB'),svg=document.getElementById('thread');
    if(!ta||!tb||!ta.offsetParent)return;
    /* a narrow screen shows one phone, so the line is off and nothing is measured for it */
    if(narrow.matches){svg.classList.add('off');return}
    var s=stage.getBoundingClientRect();
    function mid(el:Element){var r=el.getBoundingClientRect();return [r.left+r.width/2,r.top+r.height/2]}
    var a=mid(ta),b=mid(tb);
    /* drawn only where both ends can be seen on their own phone: an end under the other phone or off the page reads as a line to nowhere */
    function seen(p:number[],el:Element){
      if(p[0]<0||p[0]>innerWidth||p[1]<0||p[1]>innerHeight)return true;
      var top=document.elementFromPoint(p[0],p[1]);
      return !!top&&el.closest('.phone')!.contains(top);
    }
    var vis=stage.classList.contains('sealed')?(seen(a,ta)&&seen(b,tb)):true;
    svg.classList.toggle('off',!vis);
    var x1=a[0]-s.left,y1=a[1]-s.top,x2=b[0]-s.left,y2=b[1]-s.top,dx=Math.max(24,Math.abs(x2-x1)*.6);
    document.getElementById('threadPath').setAttribute('d','M'+x1+' '+y1+' C'+(x1+dx)+' '+y1+' '+(x2-dx)+' '+y2+' '+x2+' '+y2);
    var A=document.getElementById('tA'),B=document.getElementById('tB');
    A!.setAttribute('cx',String(x1));A!.setAttribute('cy',String(y1));B!.setAttribute('cx',String(x2));B!.setAttribute('cy',String(y2));
  }
  window.addEventListener('resize',drawThread);
  var tq=0;window.addEventListener('scroll',function(){if(!tq){tq=1;requestAnimationFrame(function(){tq=0;drawThread()})}},{passive:true});
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(drawThread);
  setTimeout(drawThread,300);

  var rungs=stage.querySelectorAll('.rung');
  function setRungs(n:number){rungs.forEach(function(r,i){r.classList.toggle('done',i<n)})}
  setRungs(3);
  if(!reduce){
    var btn=document.getElementById('confirmBtn'),t=[],on=false,paused=false,pb=document.getElementById('hpause');
    /* wait, sheet up, press Confirm, sealed, hold, then again; it stops while the hero is off screen */
    function clr(){t.forEach(clearTimeout);t=[]}
    function cycle(){
      clr();
      stage.classList.remove('sealed','sheet-up');btn.classList.remove('press');setRungs(1);
      t.push(setTimeout(function(){stage.classList.add('sheet-up')},1600));
      t.push(setTimeout(function(){btn.classList.add('press')},3200));
      t.push(setTimeout(function(){btn.classList.remove('press');stage.classList.remove('sheet-up');setRungs(2)},3600));
      t.push(setTimeout(function(){stage.classList.add('sealed');setRungs(3);drawThread()},4300));
      t.push(setTimeout(cycle,7500));
    }
    function rest(){clr();btn.classList.remove('press');stage.classList.remove('sheet-up');stage.classList.add('sealed');setRungs(3);drawThread()}
    if('IntersectionObserver' in window){
      new IntersectionObserver(function(es){var v=es[0].isIntersecting;if(v&&!on){on=true;if(!paused)cycle()}else if(!v&&on){on=false;rest()}},{threshold:.25}).observe(stage);
    }else{setTimeout(cycle,2600)}
    if(pb){pb.hidden=false;pb.addEventListener('click',function(){
      paused=!paused;pb.classList.toggle('is-paused',paused);pb.setAttribute('aria-label',paused?'Play animation':'Pause animation');
      if(paused)rest();else if(on)cycle()})}
  }

})();
</script>
<script>
(function(){
  /* how it works: copy each step's screen into the sticky phone, show the one being read. The copies
     are made the first time the pinned phone is laid out, so a phone, which never shows it, never pays for them. */
  var hs=document.getElementById('howScreen'),steps=document.querySelectorAll('.hstep'),dots=document.querySelectorAll('.how-dots li');
  if(hs){
    var filled=false;
    function fill(){filled=true;steps.forEach(function(s){var a=s.querySelector('.hscreen>.app');if(a)hs.appendChild(a.cloneNode(true))})}
    function act(n:number){var layers=hs.children;for(var i=0;i<layers.length;i++)layers[i].classList.toggle('on',i===n);dots.forEach(function(d,i){d.classList.toggle('on',i===n)})}
    /* one rule: the active step is the last whose top has passed 40% of the screen; step 1 until then, step 4 until the section ends.
       Only the wide layout has the pinned phone, so nothing switches where each step carries its own phone. */
    var hcur=-1,hq=0;
    function hpick(){hq=0;if(!hs.offsetParent)return;if(!filled)fill();var line=innerHeight*.4,n=0;
      for(var i=0;i<steps.length;i++){if(steps[i].getBoundingClientRect().top<=line)n=i}
      if(n!==hcur){hcur=n;act(n)}}
    window.addEventListener('scroll',function(){if(!hq){hq=1;requestAnimationFrame(hpick)}},{passive:true});
    window.addEventListener('resize',hpick);hpick();
  }
  /* is it for me: on a wide screen the pinned phone shows the door being read */
  var blks=[].slice.call(document.querySelectorAll('.fm3-blk')) as HTMLElement[],scrs=[].slice.call(document.querySelectorAll('.fm3-scr')) as HTMLElement[],sums=[].slice.call(document.querySelectorAll('.fm3-sum')) as HTMLElement[],flab=document.getElementById('fm3Lab'),labs:Record<string,string>={"you":"Sarah’s phone · Grace","grp":"Kisaasi Savers · Register","biz":"Mukasa Traders’ phone · Sarah"};
  var fdev=document.querySelector<HTMLElement>('.fm3-dev');
  function fsize(k:string){if(!fdev)return;var sc=fdev.querySelector<HTMLElement>('.fm3-scr[data-k="'+k+'"] .app');if(sc&&sc.offsetHeight)fdev.style.height=(sc.offsetHeight+46)+'px'}
  function fshow(k:string){fsize(k);blks.forEach(function(b){b.classList.toggle('on',b.dataset.k===k)});scrs.forEach(function(s){s.classList.toggle('on',s.dataset.k===k)});sums.forEach(function(s){s.classList.toggle('on',s.dataset.k===k)});if(flab)flab.textContent=labs[k]}
  /* a door holds the phone until the next door's heading crosses the middle of the screen */
  var fcurK:string|undefined,fq=0;
  function fpick(){fq=0;if(!blks.length)return;var mid=innerHeight/2,k=blks[0].dataset.k;blks.forEach(function(b){var h=b.querySelector('.fm3-hd')||b;if(h.getBoundingClientRect().top<=mid)k=b.dataset.k});if(k!==fcurK){fcurK=k;fshow(k!)}}
  window.addEventListener('scroll',function(){if(!fq){fq=1;requestAnimationFrame(fpick)}},{passive:true});window.addEventListener('resize',fpick);fpick();
})();
</script>
