---
/* The summary card under each door's screen: Sarah's Bills & Debts, her passbook in Kisaasi
   Savers, and Mukasa Traders' month. Drawn in the door and again under the pinned phone. */
interface Props {
  k: 'you' | 'grp' | 'biz';
}
const { k } = Astro.props;
---
{k === 'you' && <div class="app fm3-card"><p class="fm3-ck">Bills &amp; Debts</p><div class="a-strip2"><div class="a-sc"><small>Owed to you</small><b class="in num">UGX 60,000</b><span class="fm3-q">1 person</span></div><div class="a-sc"><small>You owe</small><b class="out num">UGX 1,060,000</b><span class="fm3-q">1 person</span></div></div><p class="fm3-scope">From records you signed</p></div>}
{k === 'grp' && <div class="app fm3-card fm3-pb"><p class="fm3-ck">Sarah’s phone · Passbook</p><div class="fm3-pbh"><small>MY SAVINGS</small><b class="num">UGX 350,000</b><span>Last entry 12 Oct</span></div>
<div class="fm3-pbr"><div><b>Member Savings</b><small>12 Oct 2026</small></div><div class="r"><b class="num in">+UGX 50,000</b><small>Leaves UGX 350,000</small></div></div>
<div class="fm3-pbr"><div><b>Member Savings</b><small>5 Oct 2026</small></div><div class="r"><b class="num in">+UGX 50,000</b><small>Leaves UGX 300,000</small></div></div></div>}
{k === 'biz' && <div class="app fm3-card"><p class="fm3-ck">Mukasa Traders’ books</p><div class="a-ov"><div class="a-ovh"><svg class="i"><use href="#i-chart"/></svg>THIS MONTH<span>UGX</span></div><div class="a-ovc"><div><small>Money in</small><b class="in num">2,450,000</b></div><div><small>Money out</small><b class="out num">1,310,000</b></div></div><p class="fm3-scope">38 records · all spaces</p></div>}
