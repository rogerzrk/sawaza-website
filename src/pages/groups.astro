---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import PhoneCrop from '../components/PhoneCrop.astro';
import AppBar from '../components/AppBar.astro';
import ContactBar from '../components/ContactBar.astro';
import Tabs from '../components/Tabs.astro';
import Avatar from '../components/Avatar.astro';
import RecordCard from '../components/RecordCard.astro';
import RegisterRow from '../components/RegisterRow.astro';
import SectionHead from '../components/SectionHead.astro';
import TLink from '../components/TLink.astro';
import CloseSection from '../components/CloseSection.astro';
---
<Base title="Groups · Sawaza" description="Households, savings groups, cash rounds and clubs keep one shared record of their money on Sawaza, and each member confirms their own part." bodyId="page-groups">
<style is:global>
/* page layout: words beside a drawn app screen */
#page-groups .duo{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,400px);gap:clamp(32px,6vw,88px);align-items:center}
#page-groups .duo.flip{grid-template-columns:minmax(0,400px) minmax(0,1fr)}
#page-groups .duo.flip>.fig{order:-1}
#page-groups .duo+.duo{margin-top:clamp(56px,8vw,96px)}
#page-groups .txt h3{font:700 clamp(26px,3.2vw,38px)/1.08 var(--display);letter-spacing:-.025em}
#page-groups .txt>p:not(.q):not(.sub-h){margin-top:16px;color:var(--dim);font-size:clamp(16px,1.6vw,18px);line-height:1.6;max-width:34em}
#page-groups .txt>p:not(.q) b{color:var(--ink);font-weight:600}
#page-groups .txt .tlink{margin-top:22px}
#page-groups .pts{list-style:none;margin:22px 0 0;padding:0;display:grid;gap:12px;max-width:34em}
#page-groups .pts li{position:relative;padding-left:22px;color:var(--dim);font-size:16px;line-height:1.55}
#page-groups .pts li::before{content:"";position:absolute;left:0;top:.68em;width:10px;height:2px;border-radius:2px;background:var(--gold)}
#page-groups .pts li b{color:var(--ink);font-weight:600}
#page-groups .pts small{color:var(--quiet);font-size:14px}
#page-groups .sub-h{margin-top:28px;font:600 12px/1 var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--quiet)}
#page-groups .sub-h+.pts{margin-top:14px}
#page-groups .stl{list-style:none;counter-reset:st;margin:24px 0 0;padding:0;display:grid;gap:16px;max-width:34em}
#page-groups .stl li{counter-increment:st;display:grid;grid-template-columns:36px minmax(0,1fr);gap:14px;align-items:start;color:var(--dim);font-size:16px;line-height:1.55}
#page-groups .stl li::before{content:counter(st);display:grid;place-items:center;width:36px;height:36px;border-radius:50%;border:1px solid var(--gold);color:var(--gold);font:700 15px/1 var(--display)}
#page-groups .stl li b{display:block;color:var(--ink);font-weight:600}
/* the figure: a caption and a screen drawn in the app's own kit */
#page-groups .fig{display:grid;gap:10px;justify-items:center;min-width:0}
#page-groups .fig>*{width:100%;max-width:400px}
#page-groups .lab{display:flex;justify-content:space-between;align-items:center;gap:12px;font:600 11px/1.3 var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--quiet)}
#page-groups .lab .ex{flex:none;font:700 10px/1 var(--body);letter-spacing:.12em;padding:5px 9px;border-radius:999px;background:var(--ground);color:var(--quiet);border:1px solid var(--line)}
#page-groups .deep .lab .ex{background:var(--deep)}
#page-groups .scr{font-size:14px;border-radius:22px;border:1px solid #2A303C;box-shadow:0 30px 60px -28px rgba(0,0,0,.9);padding-bottom:.6em}
#page-groups .scr.flush{padding-bottom:0}
#page-groups .pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(20px,3vw,32px);align-items:start}
#page-groups .trio{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(18px,2.4vw,28px);align-items:start}
#page-groups .pair .fig>*,#page-groups .trio .fig>*{max-width:none}
#page-groups .after{margin-top:clamp(36px,5vw,56px);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 48px}
#page-groups .after .pts{margin-top:0}
/* kind cards beside the chooser */
#page-groups .kinds{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
#page-groups .kc{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:20px 20px 18px;display:grid;gap:8px;align-content:start}
#page-groups .kc h3{font:700 20px/1.2 var(--display);letter-spacing:-.02em}
#page-groups .kc p{color:var(--dim);font-size:15px;line-height:1.5}
#page-groups .kc .tlink{font-size:15px;min-height:44px;margin-bottom:-12px}
#page-groups .kc .n{font:600 11px/1 var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
#page-groups .note{margin-top:18px;color:var(--quiet);font-size:14px;max-width:40em}
/* app parts the home draws inside its own sections, redrawn here from the same values */
#page-groups .app .t-pt{font:700 1.375em/1.15 var(--body);letter-spacing:-.01em;padding:.2em 1rem 0;padding-inline:1em}
#page-groups .app .t-ln{font-size:.875em;color:var(--a-dim);padding:.35em 1em .7em;line-height:1.45}
#page-groups .app .kk{margin:0 1em .5em;background:var(--a-surface);border:1px solid var(--a-line);border-radius:1em;padding:.7em .85em}
#page-groups .app .kk b{display:block;font:600 1em/1.25 var(--body)}
#page-groups .app .kk small{display:block;font-size:.8125em;color:var(--a-dim);line-height:1.35;margin-top:.15em}
#page-groups .app .kk.on{border-color:#E3A82B;background:var(--a-goldGround)}
#page-groups .app .kk.ic{display:grid;grid-template-columns:2.4em minmax(0,1fr) auto;gap:.75em;align-items:center}
#page-groups .app .kk.ic>i{width:2.4em;height:2.4em;border-radius:50%;background:var(--a-goldGround);display:grid;place-items:center;color:#E3A82B}
#page-groups .app .kk.ic>i svg{width:1.2em;height:1.2em}
#page-groups .app .kk.ic>svg{width:1.25em;height:1.25em;color:var(--a-goldText)}
#page-groups .app .gbar{display:flex;gap:.7em;align-items:center;padding:.85em 1em .8em;background:rgba(154,165,240,.16);border-bottom:2px solid #9AA5F0;margin-bottom:.4em}
#page-groups .app .gbar b{display:block;font:700 1.125em/1.2 var(--display);color:#C9CFF7}
#page-groups .app .gbar span:not(.a-av){display:block;font-size:.8125em;color:var(--a-dim)}
#page-groups .app .gbar.mv{background:rgba(214,160,224,.14);border-bottom-color:#D2A0E0}
#page-groups .app .gbar.mv b{color:#EBCDF2}
#page-groups .app .key{font:700 .6875em/1 var(--body);letter-spacing:.09em;text-transform:uppercase;color:var(--a-dim);padding:.9em 1em .5em}
#page-groups .app .pend{font-weight:700;color:var(--a-goldText)}
#page-groups .app .pill{display:inline-flex;align-items:center;height:1.6em;padding:0 .6em;border-radius:99em;background:var(--a-well);font:700 .6875em/1 var(--body);letter-spacing:.05em;text-transform:uppercase;color:var(--a-dim);margin-left:.45em;vertical-align:.15em}
#page-groups .app .mem{display:grid;grid-template-columns:2.75em minmax(0,1fr);gap:.75em;align-items:center;padding:.6em 1em;position:relative}
#page-groups .app .mem+.mem::before{content:"";position:absolute;top:0;left:4.75em;right:1em;height:1px;background:var(--a-line)}
#page-groups .app .mem b{font:600 1.0625em/1.25 var(--body)}
#page-groups .app .mem small{display:block;font-size:.875em;color:var(--a-dim);margin-top:.1em}
#page-groups .app .a-reg.gone{opacity:.72}
#page-groups .app .pbh{display:grid;gap:.2em;margin:.2em .8em .4em;padding:.9em 1em;border-radius:1.1em;background:var(--a-surface)}
#page-groups .app .pbh small{font:700 .75em/1 var(--body);letter-spacing:.08em;color:var(--a-dim)}
#page-groups .app .pbh b{font:700 1.1875em/1.2 var(--display);letter-spacing:-.02em;color:var(--a-text)}
#page-groups .app .pbh span{font-size:.8125em;color:var(--a-dim)}
#page-groups .app .pbr{display:flex;justify-content:space-between;gap:.8em;padding:.6em 1em;border-top:1px solid var(--a-line)}
#page-groups .app .pbr b{display:block;font:600 .9375em/1.3 var(--body);color:var(--a-text)}
#page-groups .app .pbr small{display:block;font-size:.78em;color:var(--a-dim)}
#page-groups .app .pbr .r{text-align:right}
#page-groups .app .pbr .r b{font-weight:700;font-size:.875em}
#page-groups .app .pbr .in{color:var(--a-in)}
#page-groups .app .pbr.wait{opacity:.62}
#page-groups .app .pbr.wait small svg{width:1em;height:1em;vertical-align:-.15em;margin-right:.25em}
#page-groups .app .ch{display:grid;grid-template-columns:auto auto minmax(0,1fr) auto;align-items:center;gap:.6em;padding:.4em 1em .7em}
#page-groups .app .ch .back,#page-groups .app .ch .more{width:1.4em;height:1.4em;color:var(--a-text)}
#page-groups .app .ch .a-av{width:3em;height:3em}
#page-groups .app .ch b{display:block;font:700 1.35em/1.1 var(--display);letter-spacing:-.02em;color:var(--a-text)}
#page-groups .app .ch div span{display:block;font-size:.8125em;color:var(--a-dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#page-groups .app .tabs{display:flex;gap:1.4em;padding:0 1.1em;border-bottom:1px solid var(--a-line);margin-bottom:.3em}
#page-groups .app .tabs span{padding:.55em 0 .65em;font:600 .9375em/1 var(--body);color:var(--a-dim);white-space:nowrap}
#page-groups .app .tabs span.on{color:var(--a-text);box-shadow:inset 0 -2px 0 #E3A82B}
#page-groups .app .owes{display:grid;gap:.15em;padding:.6em 1em .8em}
#page-groups .app .owes b{font:600 1em/1.3 var(--body);color:var(--a-text)}
#page-groups .app .owes strong{font:700 1.25em/1.2 var(--body)}
#page-groups .app .owes .in{color:var(--a-in)}#page-groups .app .owes .out{color:var(--a-out)}
#page-groups .app .owes span{font-size:.875em;color:var(--a-dim)}
#page-groups .app .sch{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:.9em;align-items:baseline;padding:.55em 1em;border-top:1px solid var(--a-line);font-size:.9375em}
#page-groups .app .key+.sch{border-top:0}
#page-groups .app .sch .num{font-weight:700}
#page-groups .app .sch em{font-style:normal;font:600 .8125em/1 var(--body);color:var(--a-quiet);min-width:4.8em;text-align:right}
#page-groups .app .sch em.p{color:var(--a-in)}#page-groups .app .sch em.d{color:var(--a-goldText)}
#page-groups .app .lf{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5em;margin:.2em 1em .4em;background:var(--a-surface);border-radius:1.125em;padding:.9em 1em}
#page-groups .app .lf small{display:block;font-size:.8125em;color:var(--a-dim)}
#page-groups .app .lf b{display:block;font:700 1.0625em/1.2 var(--display);letter-spacing:-.02em;margin-top:.2em;white-space:nowrap}
#page-groups .app .lt{font-size:.875em;color:var(--a-dim);padding:0 1em .5em}
#page-groups .app .menu{margin:.4em .8em .2em;background:var(--a-surface);border-radius:1.125em;padding:.3em 0 .4em;box-shadow:0 2px 4px rgba(0,0,0,.4),0 20px 44px -10px rgba(0,0,0,.6),inset 0 0 0 1px rgba(255,255,255,.06)}
#page-groups .app .menu .mem{padding:.55em .9em}
#page-groups .app .menu .mem.on{background:var(--a-lift)}
#page-groups .app .chips{display:flex;gap:.5em;flex-wrap:wrap}
#page-groups .app .chips span{display:inline-flex;align-items:center;height:2.25em;padding:0 .95em;border-radius:99em;background:var(--a-surface);border:1px solid var(--a-line);font:600 .875em/1 var(--body);color:var(--a-dim)}
#page-groups .app .chips span.on{background:#E3A82B;border-color:#E3A82B;color:#0F1219}
#page-groups .app .a-dp.on-in{background:rgba(99,192,139,.12);border-color:rgba(99,192,139,.45);color:var(--a-in)}
#page-groups .app .a-amt.in{color:var(--a-in)}
#page-groups .app .inv{margin:.5em 1em .3em;background:var(--a-surface);border-radius:1.125em;padding:1em;box-shadow:inset 0 0 0 1px rgba(255,255,255,.04),0 6px 15px -6px rgba(0,0,0,.45)}
#page-groups .app .inv .iw{display:flex;gap:.7em;align-items:center}
#page-groups .app .inv .iw b{display:block;font:700 1.125em/1.2 var(--display)}
#page-groups .app .inv .iw span:not(.a-av){display:block;font-size:.8125em;color:var(--a-dim)}
#page-groups .app .inv p{font-size:.9375em;color:var(--a-dim);line-height:1.45;margin-top:.75em}
#page-groups .app .inv .a-two{margin-top:.9em}
#page-groups .app .a-cbtns svg{width:1.1em;height:1.1em}
@media (max-width:1099px){#page-groups .trio{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:900px){
  #page-groups .duo,#page-groups .duo.flip{grid-template-columns:minmax(0,1fr)}
  #page-groups .duo.flip>.fig{order:2}
  #page-groups .fig{justify-items:start}
  #page-groups .after{grid-template-columns:minmax(0,1fr)}
}
@media (max-width:760px){#page-groups .pair,#page-groups .trio{grid-template-columns:minmax(0,1fr)}#page-groups .pair .fig>*,#page-groups .trio .fig>*{max-width:400px}}
@media (max-width:560px){#page-groups .kinds{grid-template-columns:minmax(0,1fr)}#page-groups .scr{font-size:13px}}
#page-groups main .tlink{min-height:44px}
#page-groups .txt h3{margin-top:18px}

#page-groups .app .a-debt .top span strong{color:inherit}
#page-groups .cap{font-size:14px;line-height:1.45;color:var(--dim);max-width:none}
#page-groups .chain{gap:clamp(36px,4.5vw,56px)}
#page-groups .chain .scr{font-size:13px}
#page-groups .chain .fig{position:relative}
#page-groups .chain .fig+.fig::before{content:"\2192";content:"\2192"/"";position:absolute;left:calc(-1*clamp(36px,4.5vw,56px)/2 - .5em);top:42%;width:1em;color:var(--gold);font:700 24px/1 var(--display)}
#page-groups .point{max-width:36em;margin:clamp(32px,4vw,48px) auto 0;text-align:center;font:600 clamp(18px,2vw,24px)/1.4 var(--display);color:var(--ink)}
#page-groups .point b{color:var(--gold);font-weight:700}
#page-groups .h2 em,#page-groups h1 em{font-style:normal;color:var(--gold)}
#page-groups .sub.own{color:var(--ink);font-weight:600}
#page-groups .picks{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px}
#page-groups .picks a{display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:999px;border:1px solid var(--line);background:var(--panel);color:var(--ink);text-decoration:none;font-weight:600;font-size:15px}
#page-groups .picks a:hover{border-color:var(--gold)}
#page-groups .pick-l{margin-top:22px;font:600 12px/1 var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--quiet)}
#page-groups .page-hero .cta-row{margin-top:22px}
#page-groups .two-p{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(20px,4vw,56px)}
#page-groups .two-p p{color:var(--dim);font-size:clamp(16px,1.6vw,18px);line-height:1.6}
#page-groups .two-p b{color:var(--ink);font-weight:600}
#page-groups .two-p a,#page-groups .rest a:not(.tlink){color:var(--gold);display:inline-block;min-height:44px;line-height:44px}
#page-groups .beta{margin-top:24px;padding:12px 16px;border-radius:12px;border:1px solid var(--line);background:var(--panel);color:var(--dim);font-size:15px;max-width:40em}
#page-groups .beta b{color:var(--ink);margin-right:.4em}
#page-groups .moment .sec-head{text-align:center;margin-inline:auto}
#page-groups .moment .sec-head .lede{margin-inline:auto}
#page-groups .moment .sec-head .h2{margin-inline:auto;max-width:18em}
#page-groups .moment .scr{font-size:15px}
#page-groups .moment .pair{max-width:1020px;margin-inline:auto}
#page-groups .moment .trio{max-width:1240px;margin-inline:auto}
#page-groups .moment .pts.one{margin:clamp(32px,4vw,48px) auto 0;max-width:38em}
#page-groups .moment .beta{margin-inline:auto;text-align:center}
#page-groups .rest{margin:24px auto 0;max-width:38em;color:var(--dim);font-size:16px;line-height:1.6;text-align:center}
#page-groups section[id]{scroll-margin-top:72px}
#page-groups .app .cbar{margin:.5em .875em .3em;height:6px;border-radius:99em;background:var(--a-well);overflow:hidden}
#page-groups .app .cbar i{display:block;height:100%;background:#E3A82B;border-radius:99em}
#page-groups .app .showall{text-align:right;padding:.6em .875em .2em;font:600 .8125em/1 var(--body);color:var(--a-goldText)}
#page-groups .app .a-cyc .a-cbtns{padding:.6em .875em 0}
@media (max-width:860px){#page-groups .chain{grid-template-columns:minmax(0,1fr)}#page-groups .chain .fig+.fig::before{content:"\2193";content:"\2193"/"";left:50%;top:calc(-1*clamp(36px,4.5vw,56px)/2 - .6em);transform:translateX(-50%)}#page-groups .chain .fig{justify-items:center}#page-groups .two-p{grid-template-columns:minmax(0,1fr)}}
#page-groups .one-p p{color:var(--dim);font-size:clamp(16px,1.6vw,18px);line-height:1.6;max-width:44em}#page-groups .one-p b{color:var(--ink);font-weight:600}
#page-groups .sec>.wrap>.rest{margin-top:20px}
@media (max-width:360px){#page-groups .app .a-quote b{white-space:normal;overflow:visible}#page-groups .app .ch div span{white-space:normal}}
#page-groups .fig>.pcrop{width:fit-content;max-width:100%}
#page-groups .fig>.pcrop.from-bottom{width:calc(22.5em + 18px)}
#page-groups .fig:has(.pcrop){justify-items:center}
#page-groups .fig:has(.pcrop)>.lab{max-width:318px}
#page-groups .kept{display:grid;gap:18px;max-width:40em;justify-items:start}
#page-groups .kept>p{color:var(--dim);font-size:clamp(16px,1.6vw,18px);line-height:1.6}
#page-groups .kept .pts{margin-top:0}
#page-groups .kept .pts li{color:var(--ink)}
#page-groups .kept .roles b{color:var(--ink);font-weight:600}
</style>
<section class="page-hero" id="top">
  <Mark class="watermark" />
  <div class="wrap split">
    <div>
      <p class="q">For groups</p>
      <h1>The money you keep <em>together</em>.</h1>
      <p class="sub">One record for the whole group. Each member confirms their own part.</p>
      <p class="sub" data-new="1">A household, a savings group or SACCO, a cash round or a club, each with an account of its own. Every member reads the group’s records.</p>
      <p class="pick-l" data-new="1">Pick yours</p>
      <div class="picks"><a href="#household">Household</a><a href="#savings">Savings group</a><a href="#round">Cash round</a></div>
      <div class="cta-row"><a class="btn btn-gold" href="/#get">Get the app</a><TLink href="/how-it-works" label="See how it works" /></div>
    </div>
    <div class="fig" role="img" aria-label="Screen of the Okello Family household account: this month, UGX 1,485,000 out, with sealed records for school fees and rent.">
      <p class="lab" aria-hidden="true">Okello Family · Activity</p>
      <PhoneCrop h="520px">
        <div class="gbar"><Avatar initials="OF" class="ent" style="background:#9AA5F0;color:#141A33" /><div><b>Okello Family</b><span>Household · Grace and Peter</span></div></div>
        <div class="a-ov"><div class="a-ovh"><svg class="i"><use href="#i-chart"/></svg>This month<span>UGX</span></div><div class="a-ovc"><div><small>Money in</small><b class="in num">0</b></div><div><small>Money out</small><b class="out num">1,485,000</b></div></div><p class="a-ovl">3 records · all spaces</p></div>
        <RecordCard initials="SM" avClass="ent" avStyle="background:#C9D3E6" name="St. Mary’s Primary" time="3 Oct" label="You paid" item="Tuition & School Fees" dir="out" amount="UGX 850,000" status="sealed" />
        <RecordCard data-key="1" initials="JA" name="James Landlord" time="1 Oct" label="You paid" item="Rent" dir="out" amount="UGX 600,000" status="sealed" />
        <RecordCard solo item="Groceries" dir="out" amount="UGX 35,000" label="Expense · 30 Sep" />
      </PhoneCrop>
    </div>
  </div>
</section>

<section class="sec deep" id="household"><div class="wrap">
  <SectionHead q="Is it for a home?" title="Household: one home, both partners on the <em>same side</em>." titleNew />
  <div class="one-p">
    <p data-new="1">Grace and Peter keep the <b>Okello Family</b> together: the rent, the school fees, the groceries. They stand on the same side of every record, so the rent record is with James Landlord, and he is the one who signs it.</p>
  </div>
</div></section>

<section class="sec moment" id="savings"><div class="wrap">
  <SectionHead q="How does a savings group keep its books?" title="A <em>register</em> for the group. A passbook for each member."><p class="lede" data-new="1">For a savings group or SACCO: each member’s savings and shares, added up from the group’s own records.</p></SectionHead>
  <div class="trio">
    <div class="fig" role="img" aria-label="Screen of the Kisaasi Savers register: four members with their savings, one line from Ruth not yet confirmed, and a member who left listed apart.">
      <p class="lab" aria-hidden="true">Kisaasi Savers · Register</p>
      <PhoneCrop h="430px">
        <AppBar title="Register" />
        <p class="key">Kisaasi Savers · 4 members</p>
