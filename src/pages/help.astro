---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { HELP_TOPICS } from '../data/help';
import { PRELAUNCH as HIDE_UNTIL_LAUNCH } from '../config';
// Before launch this page is not published: its address sends the visitor Home.
if (HIDE_UNTIL_LAUNCH) return Astro.redirect('/');
---
<Base title="Help · Sawaza" description="What Sawaza costs, and answers to the usual questions: signing in, lost phones, who sees your records, groups and businesses." bodyId="page-help">
<style is:global>
#page-help .next-row .tlink{min-height:44px}
#page-help .vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
#page-help .find{position:relative;margin-top:30px;max-width:34em}
#page-help .find svg{position:absolute;left:18px;top:50%;width:20px;height:20px;transform:translateY(-50%);fill:none;stroke:var(--quiet);stroke-width:2;stroke-linecap:round;pointer-events:none}
#page-help .find input{width:100%;min-height:56px;padding:0 18px 0 50px;border-radius:14px;border:1px solid var(--line);background:var(--panel);color:var(--ink);font:500 17px/1.2 var(--body);box-sizing:border-box}
#page-help .find input::placeholder{color:var(--quiet)}
#page-help .find input:focus{outline:2px solid var(--gold);outline-offset:2px;border-color:transparent}
#page-help .topics{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:28px}
#page-help .topics a{display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:99px;border:1px solid var(--line);color:var(--dim);text-decoration:none;font:500 14.5px/1.2 var(--body)}
#page-help .topics a:hover{color:var(--ink);border-color:var(--gold)}
#page-help .count{color:var(--quiet);font-size:14px;min-height:1.2em;margin:-8px 0 16px}
#page-help .faq{display:grid;gap:clamp(40px,5vw,56px);max-width:72em}
#page-help .topic{scroll-margin-top:96px}
#page-help .topic h2{font-size:clamp(22px,2.6vw,28px);font-weight:700;margin-bottom:14px}
#page-help .qa{border-top:1px solid var(--line)}
#page-help .qa:last-child{border-bottom:1px solid var(--line)}
#page-help .qa summary{min-height:44px;list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 2px;font:600 clamp(16px,1.7vw,18px)/1.35 var(--body);color:var(--ink)}
#page-help .qa summary::-webkit-details-marker{display:none}
#page-help .qa summary:focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:6px}
#page-help .qa .chev{width:22px;height:22px;flex:none;fill:none;stroke:var(--gold);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;transition:transform .2s}
#page-help .qa[open] .chev{transform:rotate(180deg)}
#page-help .ans{padding:0 2px 22px;color:var(--dim);font-size:16.5px;line-height:1.65;max-width:62em}
#page-help .ans p+p,#page-help .ans ul{margin-top:10px}
#page-help .ans ul{padding-left:1.2em}
#page-help .ans li+li{margin-top:6px}
#page-help .ans b{color:var(--ink)}
#page-help mark{background:var(--goldsoft);color:var(--ink);border-radius:3px;padding:0 2px}
#page-help .none{padding:28px;border-radius:16px;border:1px dashed var(--line);color:var(--dim);max-width:72em}
#page-help .none b{color:var(--ink)}
#page-help .ways{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;max-width:72em}
#page-help .way{padding:22px;border-radius:16px;background:var(--panel);border:1px solid var(--line);display:grid;gap:8px;align-content:start}
#page-help .way svg{width:30px;height:30px;fill:none;stroke:var(--gold);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
#page-help .way b{font:600 18px/1.2 var(--display)}
#page-help .way p{color:var(--dim)}
@media (prefers-reduced-motion:reduce){#page-help .qa .chev{transition:none}}
</style>
<section class="page-hero" id="top">
  <svg class="watermark" viewBox="0 0 1000 1000" aria-hidden="true"><g fill="currentColor"><path d="M113.394,690.625 L237.500,690.625 A184.375,190.625 0 0 0 421.875,500.000 A340.625,334.375 0 0 1 762.500,165.625 L810.606,165.625 A25.000,25.000 0 0 0 826.950,121.712 A500.000,500.000 0 0 0 12.163,609.619 A103.750,103.750 0 0 0 113.394,690.625 Z"/><path d="M886.606,309.375 L762.500,309.375 A184.375,190.625 0 0 0 578.125,500.000 A340.625,334.375 0 0 1 237.500,834.375 L189.394,834.375 A25.000,25.000 0 0 0 173.050,878.288 A500.000,500.000 0 0 0 987.837,390.381 A103.750,103.750 0 0 0 886.606,309.375 Z"/></g></svg>
  <div class="wrap">
    <div>
      <p class="q">Help</p>
      <h1>What it costs, and answers to the <em>usual</em> questions.</h1>
      <p class="sub">Sawaza is free to use: write records, send them and keep them, with no fees.</p>
      <div class="find" role="search">
        <label for="faq-q" class="vh">Search the answers</label>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 20 20"/></svg>
        <input id="faq-q" type="search" placeholder="Search: lost phone, groups, cost" autocomplete="off" data-new="1">
      </div>
    </div>
  </div>
</section>

<section class="sec deep" id="answers"><div class="wrap">
  <nav class="topics" aria-label="Topics">
    <a href="#money">Money and cost</a><a href="#start">Getting started</a><a href="#privacy">Who sees what</a><a href="#records">Answering a record</a><a href="#groups">Groups</a><a href="#business">Businesses</a>
  </nav>
  <p class="count" id="faq-count" aria-live="polite"></p>
  <div class="faq">
{HELP_TOPICS.map((t) => <Faq topic={t} />)}
  </div>
  <div class="none" id="faq-none" hidden data-new="1">
    <p><b>No answer matches that yet.</b></p>
    <p>Try another word, or email us at admin@sawaza.app and we will answer there.</p>
  </div>
</div></section>
<section class="sec" id="contact"><div class="wrap">
  <div class="sec-head"><p class="q">Still stuck?</p><h2 class="h2">Talk to us.</h2><p class="lede" data-new="1">Email us, and we will answer there.</p></div>
  <div class="ways">
    <div class="way"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg><b>Email</b><p>admin@sawaza.app</p></div>
  </div>
  <div class="next-row"><a class="tlink" href="/how-it-works">See how it works <span aria-hidden="true">→</span></a><a class="tlink" href="/trust">Trust and privacy <span aria-hidden="true">→</span></a></div>
</div></section>
<script>
(function(){
  var input=document.getElementById('faq-q') as HTMLInputElement|null;if(!input)return;
  var items=[].slice.call(document.querySelectorAll('#page-help .qa')) as (HTMLDetailsElement&{_t:string,_open:boolean})[];
  var topics=[].slice.call(document.querySelectorAll('#page-help .topic')) as HTMLElement[];
  var none=document.getElementById('faq-none')!,count=document.getElementById('faq-count')!;
  items.forEach(function(d){d._t=d.textContent.toLowerCase();d._open=d.open});
  function run(){
    var q=input.value.trim().toLowerCase(),words=q.split(/\s+/).filter(Boolean),shown=0;
    items.forEach(function(d){
      var hit=words.every(function(w){return d._t.indexOf(w)>-1});
      d.hidden=!hit;if(hit)shown++;
      d.open=words.length?hit:d._open;
    });
    topics.forEach(function(s){s.hidden=!s.querySelector('.qa:not([hidden])')});
    none.hidden=shown>0;
    count.textContent=words.length?(shown===1?'1 answer':shown+' answers'):'';
  }
  input.addEventListener('input',run);
  var p=new URLSearchParams(location.search).get('q');if(p){input.value=p;run()}
})();
</script>
</Base>
