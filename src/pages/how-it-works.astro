---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import Mark from '../components/Mark.astro';
import HeroPhone from '../components/HeroPhone.astro';
import PhoneCrop from '../components/PhoneCrop.astro';
import AppBar from '../components/AppBar.astro';
import ContactBar from '../components/ContactBar.astro';
import Tabs from '../components/Tabs.astro';
import Thread from '../components/Thread.astro';
import ConfirmSheet from '../components/ConfirmSheet.astro';
import RecordCard from '../components/RecordCard.astro';
import SectionHead from '../components/SectionHead.astro';
import TLink from '../components/TLink.astro';
import CloseSection from '../components/CloseSection.astro';
import { PERSONAL_TABS, sarahWithDavid, davidWithSarah } from '../components/threads';
import { PRELAUNCH as HIDE_UNTIL_LAUNCH } from '../config';
// Before launch this page is not published: its address sends the visitor Home.
if (HIDE_UNTIL_LAUNCH) return Astro.redirect('/');
---
<Base title="How it works · Sawaza" description="Follow one record from written to sealed: how you write it, how it reaches the other side, how they answer, and what each side keeps." bodyId="page-how-it-works">
<Fragment slot="rail">
<Rail items={[['top', 'How does it work?'], ['steps', 'What are the steps?'], ['disagree', 'What if they disagree?'], ['private', 'Who sees my records?']]} />
</Fragment>
<style is:global>
/* How it works: one record from written to sealed. Built from kit tokens and the home's app drawings. */
#page-how-it-works .hw-steps{list-style:none;margin:30px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:10px}
#page-how-it-works .hw-steps a{display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:0 16px 0 8px;border-radius:99px;border:1px solid var(--line);background:rgba(255,255,255,.03);color:var(--ink);font:600 15px/1 var(--body);text-decoration:none}
#page-how-it-works .hw-steps a:hover{border-color:var(--gold)}
#page-how-it-works .hw-steps i{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;border:2px solid var(--gold);color:var(--gold);font:700 13px/1 var(--body);font-style:normal}
#page-how-it-works .hw-steps i.t,#page-how-it-works .hn i.t{border-color:var(--teal);color:var(--teal)}
#page-how-it-works .hw-steps li:last-child a{color:var(--teal)}
#page-how-it-works .hw-hero{min-width:0;display:grid;justify-items:center}
#page-how-it-works .hw-hero .stage{--pw:clamp(170px,19vw,250px);padding-bottom:30px}
#page-how-it-works .hw-hero .chip-cap{--capgap:28px}
@media (max-width:900px){#page-how-it-works .hw-hero .stage{--pw:min(42vw,250px)}}

#page-how-it-works .hw{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(32px,6vw,88px);align-items:center}
#page-how-it-works .hw.flip>.hw-vis{order:-1}
#page-how-it-works .htext{max-width:34em}
#page-how-it-works .htext .q{margin-bottom:4px}
#page-how-it-works .hw-vis{display:flex;justify-content:center;align-items:flex-start;min-width:0}
#page-how-it-works .hw-label{margin-top:8px;font:600 12px/1 var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--quiet)}
#page-how-it-works .htext .side{margin-top:0;max-width:340px}
#page-how-it-works .htext>p.hw-note{font-size:15px;color:var(--quiet)}
#page-how-it-works .lede .ink,#page-how-it-works .ink{color:var(--ink);font-weight:600}

#page-how-it-works .hw-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(20px,3vw,40px);align-items:start}
#page-how-it-works .hw-way{margin:0;display:grid;gap:22px;justify-items:center;min-width:0;padding:clamp(20px,3vw,32px);border-radius:22px;background:var(--panel);border:1px solid var(--line)}
#page-how-it-works .hw-way figcaption{display:grid;gap:8px;width:100%;max-width:30em}
#page-how-it-works .hw-way figcaption b{font:700 clamp(20px,2vw,24px)/1.2 var(--display);color:var(--ink);letter-spacing:-.01em}
#page-how-it-works .hw-way figcaption>span:not(.hw-tag){color:var(--dim);font-size:16px;line-height:1.55}
#page-how-it-works .hw-tag{justify-self:start;font:600 12px/1 var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
#page-how-it-works .hw-way .side{margin-top:0}
#page-how-it-works .hw-way{align-self:stretch;align-content:start}
#page-how-it-works .hw-way>.hw-vis{align-self:center}
#page-how-it-works .hw-way .hscreen{height:34em}
#page-how-it-works .htext>p.q{font-size:12px;line-height:1;color:var(--gold)}
#page-how-it-works .sec-head .hn{margin-bottom:-4px}
#page-how-it-works .hw-way .wa2{max-width:320px}

#page-how-it-works .hw-defs{list-style:none;margin:8px 0 0;padding:0;display:grid}
#page-how-it-works .hw-defs li{display:grid;grid-template-columns:40px minmax(0,1fr);gap:14px;align-items:start;padding:14px 0;border-top:1px solid var(--line)}
#page-how-it-works .hw-defs li:last-child{border-bottom:1px solid var(--line)}
#page-how-it-works .hw-defs i{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.05);border:1px solid var(--line);color:var(--dim)}
#page-how-it-works .hw-defs i.g{color:var(--gold)}
#page-how-it-works .hw-defs svg.i{width:18px;height:18px}
#page-how-it-works .hw-defs b{display:block;color:var(--ink);font-weight:600;font-size:16.5px}
#page-how-it-works .hw-defs span{display:block;color:var(--dim);font-size:15px;line-height:1.5;margin-top:2px}

#page-how-it-works .hw-card{font-size:12.5px;border-radius:16px;background:#0F1219;border:1px solid #2A303C;padding:.3em 0;box-shadow:0 24px 50px -30px rgba(0,0,0,.9);width:100%;max-width:340px}
#page-how-it-works .a-rf .ne{font:700 1.2em/1 var(--body);color:var(--a-clay)}
#page-how-it-works .a-rf .cl{color:var(--a-clay)}
#page-how-it-works .a-rf .dx{color:var(--a-out)}
#page-how-it-works .a-rf .qt{color:var(--a-quiet)}

#page-how-it-works .hw-states{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(16px,2.4vw,28px)}
#page-how-it-works .hw-st{margin:0;display:grid;gap:16px;align-content:start;min-width:0}
#page-how-it-works .hw-st .hw-card{max-width:none}
#page-how-it-works .hw-st figcaption{display:grid;gap:6px;padding:0 4px}
#page-how-it-works .hw-st figcaption b{font:700 20px/1.2 var(--display);color:var(--ink)}
#page-how-it-works .hw-st figcaption span{color:var(--dim);font-size:15px;line-height:1.5}
#page-how-it-works .hw-foot{margin-top:clamp(28px,4vw,44px);max-width:44em;color:var(--dim);font-size:clamp(16px,1.6vw,18px);line-height:1.6}

#page-how-it-works .hw-stack{flex-direction:column;align-items:center;gap:16px}
#page-how-it-works .hw-sheet{padding:.9em;display:grid;gap:.6em}
#page-how-it-works .hw-sheet .a-f{box-shadow:none;border:1px solid #2A303C}
#page-how-it-works .hw-sheet .a-share{border:1px solid #2A303C}
#page-how-it-works .a-sw.off{background:var(--a-sand)}
#page-how-it-works .a-sw.off::after{right:auto;left:.2em;background:var(--a-dim)}

#page-how-it-works .hw-kinds{list-style:none;margin:6px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
#page-how-it-works .hw-kinds li{padding:7px 12px;border-radius:99px;border:1px solid var(--line);font:500 14px/1 var(--body);color:var(--dim)}
#page-how-it-works .hw-spaces{padding:.6em 0 .4em}
#page-how-it-works .who-lab{padding:.2em 1em .6em;font:600 .75em/1 var(--body);letter-spacing:.1em;text-transform:uppercase;color:var(--a-quiet)}
#page-how-it-works .k-h{display:flex;align-items:center;gap:.6em;padding:.2em 1em .6em}
#page-how-it-works .k-h b{font:700 1.5em/1 var(--display);letter-spacing:-.025em}
#page-how-it-works .k-cap{padding:0 1em .5em;font-size:.875em;color:var(--a-dim);line-height:1.4}
#page-how-it-works .k-sec{padding:.4em 1em .35em;font:700 .75em/1 var(--body);letter-spacing:.08em;text-transform:uppercase;color:var(--a-dim)}
#page-how-it-works .k-fold{display:grid;grid-template-columns:2.6em minmax(0,1fr) auto;gap:.75em;align-items:center;padding:.55em 1em;border-top:1px solid var(--a-line)}
#page-how-it-works .k-sec+.k-fold{border-top:0}
#page-how-it-works .k-fold .f{width:2.6em;height:2.6em;border-radius:.75em;display:grid;place-items:center}
#page-how-it-works .k-fold .f svg{width:1.35em;height:1.35em;fill:none;stroke:currentColor;stroke-width:2}
#page-how-it-works .k-fold b{display:block;font:600 1.0625em/1.25 var(--body);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#page-how-it-works .k-fold small{display:block;font-size:.875em;color:var(--a-dim)}
#page-how-it-works .k-fold .cr{width:1.1em;height:1.1em;color:var(--a-quiet)}

#page-how-it-works .hw-mirror .hw-way{gap:16px}
#page-how-it-works .hw-mirror .hw-card{max-width:380px}
#page-how-it-works .hw-goes{display:grid;grid-template-columns:1fr 1fr;gap:.6em;padding:.4em 1em .8em}
#page-how-it-works .hw-goes .a-f{box-shadow:none;border:1px solid #2A303C}
#page-how-it-works .hw-split{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(24px,4vw,56px);margin-top:clamp(36px,5vw,56px)}
#page-how-it-works .hw-split .lbl{margin-bottom:0}
#page-how-it-works .hw-split .facts{margin-top:14px}

@media (max-width:899px){
  #page-how-it-works .hw{grid-template-columns:minmax(0,1fr)}
  #page-how-it-works .hw.flip>.hw-vis{order:0}
  #page-how-it-works .hw-states{grid-template-columns:minmax(0,1fr);max-width:420px;margin-inline:auto}
}
@media (max-width:760px){
  #page-how-it-works .hw-two,#page-how-it-works .hw-split{grid-template-columns:minmax(0,1fr)}
}
@media (max-width:420px){
  #page-how-it-works .hw-way{padding:18px 14px}
  #page-how-it-works .hphone{font-size:11.6px}
}

#page-how-it-works .a-note .act{display:flex;gap:1.6em}
#page-how-it-works .facts svg,#page-how-it-works .hw-split .facts svg{color:var(--gold)}
#page-how-it-works .tlink{min-height:44px}
#page-how-it-works .hw-num i{font:700 15px/1 var(--body);font-style:normal;color:var(--gold);border:2px solid var(--gold);background:none}
#page-how-it-works .hw-num i.t{color:var(--teal);border-color:var(--teal)}
#page-how-it-works .hw-num b{font-size:18px}
#page-how-it-works .hw-card{max-width:380px}
#page-how-it-works .hw-hero .t-fab{display:none}
@media (max-width:520px){#page-how-it-works .hw-hero .ph-wrap+.ph-wrap{margin-left:8px}}
</style>
<section class="page-hero" id="top">
  <Mark class="watermark" />
  <div class="wrap split">
    <div>
      <p class="q">How does it work?</p>
      <h1>From a payment to a <em>sealed</em> record.</h1>
      <p class="sub" data-new="1">Follow one record: the rent Sarah pays David. She writes it, he answers it, and both of them end up holding the same signed copy.</p>
    </div>
    <div class="hw-hero">
      <div class="stage sealed" role="img" aria-label="Sarah's thread with David and David's thread with Sarah. The October rent record is sealed on both phones.">
        <div class="ph-wrap"><p class="who">Sarah's phone</p><HeroPhone crop="pc-sm" style="--crop-h:min(116vw,440px)"><ContactBar who="david" name="David Landlord" sub="On Sawaza · +256 772 410 118" /><Tabs tabs={PERSONAL_TABS} /><Thread heads={['David Landlord', 'You']} items={sarahWithDavid} fab /></HeroPhone></div>
        <div class="ph-wrap"><p class="who">David's phone</p><HeroPhone crop="pc-sm" style="--crop-h:min(116vw,440px)"><ContactBar who="sarah" name="Sarah" sub="On Sawaza · +256 701 552 093" /><Tabs tabs={PERSONAL_TABS} /><Thread heads={['Sarah', 'You']} items={davidWithSarah} fab /></HeroPhone></div>
      </div>
      <p class="chip-cap"><span class="cc"><svg class="cver" aria-hidden="true"><use href="#i-ver"/></svg><span><b>Sawa. Sealed.</b> means you both signed.</span></span></p>
    </div>
  </div>
</section>

<!-- The four steps -->
<section class="sec deep" id="steps"><div class="wrap">
  <div class="hw flip">
    <div class="htext">
      <p class="q">What are the steps?</p>
      <h2 class="h2">Write it, send it, they answer.</h2>
      <ol class="hw-defs hw-num">
        <li><i>1</i><div><b>Write it.</b><span>Who, how much and what for. A phone contact, a number, or just a name.</span></div></li>
        <li><i>2</i><div><b>Send it.</b><span data-new="1">They get it in Sawaza. Not on Sawaza yet? They get a link on WhatsApp or SMS. Nothing is signed from the notification: they open the record and answer it there.</span></div></li>
        <li><i>3</i><div><b>They answer.</b><span>Confirm, "The details are wrong", or "This isn't mine". Or Later: the record waits, unsigned.</span></div></li>
        <li><i class="t">4</i><div><b>Sawa. Sealed.</b><span data-new="1">You both signed. You both hold the same copy, on the same page.</span></div></li>
      </ol>
    </div>
    <div class="hw-vis" role="img" aria-label="David's phone, Confirm this record sheet: Sarah paid you UGX 450,000, with the button Confirm, I received it, and the options Something's wrong and Later."><PhoneCrop h="470px" fromBottom>
  <AppBar wordmark avatar="david" />
  <RecordCard wash who="sarah" name="Sarah" time="10:21 am" label="Paid you" item="Rent" dir="in" amount="UGX 450,000" status="awaiting-you" />
  <ConfirmSheet />
</PhoneCrop></div>
  </div>
</div></section>

<!-- When it isn't sealed -->
<section class="sec" id="disagree"><div class="wrap">
  <div class="hw">
    <div class="htext">
      <p class="q">What if they disagree?</p><h2 class="h2">Both versions are kept.</h2>
      <p>Until everyone it names has signed, a record says plainly where it stands, on both phones. <strong class="ink">Sawaza is a witness, not a judge.</strong></p>
      <ul class="hw-defs">
        <li><i class="g"><svg class="i"><use href="#i-clock"/></svg></i><div><b>Awaiting</b><span>Waiting on Grace · not sealed until they sign it</span></div></li>
        <li><i class="g"><svg class="i"><use href="#i-edit"/></svg></i><div><b>Contested</b><span>Contested · both versions are kept</span></div></li>
        <li><i class="g"><svg class="i"><use href="#i-block"/></svg></i><div><b>Declined</b><span>Declined · this record is off your books</span></div></li>
      </ul>
    </div>
    <div class="hw-vis" role="img" aria-label="Three record rows: you lent Grace UGX 100,000, Awaiting Grace; you paid Joseph UGX 300,000, Joseph contested it, version 2; you paid Peter UGX 20,000, Declined."><PhoneCrop h="470px"><AppBar wordmark /><RecordCard who="grace" name="Grace" time="12 Oct" label="You lent" item="Tuition & School Fees" dir="out" amount="UGX 100,000" status="awaiting" statusName="Grace" /><RecordCard who="joseph" name="Joseph" time="20 Oct" label="You paid" item="Goods" dir="out" amount="UGX 300,000" status="contested" statusName="Joseph contested · v2" /><RecordCard initials="PE" name="Peter" time="22 Oct" label="You paid" item="Boda-boda" dir="out" amount="UGX 20,000" status="declined" /></PhoneCrop></div>
  </div>
</div></section>

<!-- Who sees -->
<section class="sec deep" id="private"><div class="wrap">
  <SectionHead q="Who sees my records?" title="Only the people you choose."><p class="lede" data-new="1">A record you write stays yours until you send it, and you never have to. The rest is on <TLink href="/trust" label="Trust and privacy" /></p></SectionHead>
  <div class="next-row"><TLink href="/groups" label="For groups" /><TLink href="/businesses" label="For businesses" /></div>
</div></section>

<CloseSection pull added />
</Base>
