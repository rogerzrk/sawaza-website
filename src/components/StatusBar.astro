---
/* The phone's status bar with its notch: "nt" is the cropped phone's cut-out, "notch" the hero
   phone's, and a pinned screen that shows no bezel has none. */
interface Props {
  notch?: 'nt' | 'notch' | 'none';
}
const { notch = 'nt' } = Astro.props;
---
{notch === 'nt' && <span class="nt"></span>}{notch === 'notch' && <div class="notch"></div>}<div class="a-sbar"><span>9:41</span><i></i></div>
