---
/* What it does: a horizontal rail of the app's tools, each drawn as a small piece of its own
   screen. The screens are the app's list rows at the app's sizes, scaled down as one block with
   zoom so their proportions stay the app's. The arrows only scroll the rail; it reads by swipe too. */
import SectionHead from '../SectionHead.astro';
import TLink from '../TLink.astro';
---
<section class="sec" id="does"><div class="wrap">
  <div class="fd-head"><SectionHead q="What does it do?" title="Every tool works from records you both signed." style="margin-bottom:0" />
  <div class="fd-arrows"><button class="fd-btn" type="button" data-d="-1" aria-label="Previous tools">&#8249;</button><button class="fd-btn" type="button" data-d="1" aria-label="Next tools">&#8250;</button></div></div>
  <ul class="fd-rail" tabindex="0" aria-label="What Sawaza does"><li class="fc"><div class="fc-ui" aria-hidden="true"><div class="scr"><div class="s-bar"><b>Records</b></div><div class="s-band"><span>OCTOBER 2026</span><span><em class="in">In UGX 0</em> <em class="out">Out UGX 470,000</em></span></div><div class="s-led"><div class="dg"><b>31</b><small>OCT</small></div><div class="lc"><div class="l1"><b class="tt">Rent <svg class="ic gold"><use href="#i-ver"/></svg></b><span class="amt out"><svg class="ic out"><use href="#i-up"/></svg>450,000</span></div><div class="l2">David Landlord · <svg class="ic dim"><use href="#i-fold"/></svg> Home</div></div></div><div class="s-led"><div class="dg"><b>12</b><small>OCT</small></div><div class="lc"><div class="l1"><b class="tt">School fees</b><span class="amt">600,000</span></div><div class="l2">Grace · Owes · <svg class="ic dim"><use href="#i-fold"/></svg> Home <span class="pill"><svg class="ic dim"><use href="#i-clock"/></svg>Awaiting Grace</span></div></div></div><div class="s-led"><div class="dg"><b>5</b><small>OCT</small></div><div class="lc"><div class="l1"><b class="tt">Boda fare <svg class="ic gold"><use href="#i-ver"/></svg></b><span class="amt out"><svg class="ic out"><use href="#i-up"/></svg>20,000</span></div><div class="l2">Peter · <svg class="ic dim"><use href="#i-fold"/></svg> Transport</div></div></div></div></div><p class="fc-tag">Everyone</p><h3>Records</h3><p class="fc-line">Write it once. Both sides sign the same record.</p></li><li class="fc"><div class="fc-ui" aria-hidden="true"><div class="scr"><div class="s-bar"><b>Contacts</b></div><div class="s-chips"><span class="on">All</span><span>People</span><span>Groups</span><span>Businesses</span></div><div class="s-inb"><span class="face ph ph-david">DA</span><div class="ib"><div class="n1"><b>David Landlord</b><time>31 Oct</time></div><div class="n2"><svg class="ic gold"><use href="#i-ver"/></svg><b class="amt out"><svg class="ic out"><use href="#i-up"/></svg>450,000</b> · Rent</div></div></div><div class="s-inb unread"><span class="face sq">MT</span><div class="ib"><div class="n1"><i class="dot"></i><b>Mukasa Traders</b><time class="gold">Today</time></div><div class="n2"><svg class="ic dim"><use href="#i-clock"/></svg><b class="amt">800,000</b> · Bill INV-0001<span class="badge">1</span></div></div></div><div class="s-inb"><span class="face ph ph-grace">GR</span><div class="ib"><div class="n1"><b>Grace</b><time>12 Oct</time></div><div class="n2"><svg class="ic dim"><use href="#i-clock"/></svg><b class="amt out"><svg class="ic out"><use href="#i-up"/></svg>600,000</b> · School fees</div></div></div></div></div><p class="fc-tag">Everyone</p><h3>Contacts</h3><p class="fc-line">Everyone you deal with, each with your latest record.</p></li><li class="fc"><div class="fc-ui" aria-hidden="true"><div class="scr"><div class="s-bar"><b>Primary Space</b></div><div class="s-tabs"><span class="on">Spaces</span><span>Records</span><span>Bills &amp; Debts</span></div><div class="s-head"><span>YOUR SPACES · 3</span><em><svg class="ic gold"><use href="#i-plus"/></svg> New space</em></div><div class="s-sp"><span class="fold" style="--t:#5CD6D6"><i></i><b>HO</b></span><div class="ib"><div class="n1"><b>Home</b><time>2d</time></div><div class="n2 dim">Household · 2 subspaces</div></div></div><div class="s-sp"><span class="fold" style="--t:#EAA57E"><i></i><b>SH</b></span><div class="ib"><div class="n1"><b>Shop</b><time>Today</time></div><div class="n2 dim">Business</div></div></div><div class="s-sp"><span class="fold" style="--t:#D2A0E0"><i></i><b></b></span><div class="ib"><div class="n1"><b>Groups</b><time>12 Oct</time></div><div class="n2 dim">2 groups · your records in each</div></div></div></div></div><p class="fc-tag">Everyone</p><h3>Spaces</h3><p class="fc-line">Keep the parts of your life apart: home, the shop, a farm, each with its own records.</p></li><li class="fc"><div class="fc-ui" aria-hidden="true"><div class="scr"><div class="s-bar"><b>Bills &amp; Debts</b></div><div class="s-strip"><div><small>Owed to you</small><b class="in">UGX 600,000</b><span>1 person</span></div><div><small>You owe</small><b class="out">UGX 800,000</b><span>1 person</span></div></div><p class="s-cap">From records you signed</p><div class="s-pr"><span class="face ph ph-grace">GR</span><div class="ib"><b>Grace</b><div class="n2 dim">1 loan · Due 1 Nov</div></div><div class="nr"><b class="in">600,000</b><small class="in">Owes you</small></div></div><div class="s-pr"><span class="face sq">MT</span><div class="ib"><b>Mukasa Traders</b><div class="n2 dim">1 debt · Due 31 Oct</div></div><div class="nr"><b class="out">800,000</b><small class="out">You owe</small></div></div></div></div><p class="fc-tag">Everyone</p><h3>Bills, debts and loans</h3><p class="fc-line">Who owes you, what you owe, and when it is due.</p></li><li class="fc"><div class="fc-ui" aria-hidden="true"><div class="scr"><div class="s-bar"><b>Balances</b></div><div class="s-card"><small class="sh">TOTAL BALANCE</small><b class="disp">UGX 1,070,000</b><span class="dim">UGX · 2 accounts</span></div><div class="s-card s-accr"><span class="kt" style="--k:#22A854"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg></span><div class="ib"><b>Cash box</b><span class="dim">Cash</span></div><div class="nr"><b>450,000</b><small class="dim">UGX</small></div></div><div class="s-card s-accr"><span class="kt" style="--k:#C9A227"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 17.5h2"/></svg></span><div class="ib"><b>My MoMo</b><span class="dim">MTN</span></div><div class="nr"><b>620,000</b><small class="dim">UGX</small></div></div></div></div><p class="fc-tag">Everyone · when you turn it on</p><h3>Balances</h3><p class="fc-line">Cash, Mobile Money and the bank in one total. Sawaza holds none of it, it keeps the figures.</p></li><li class="fc"><div class="fc-ui" aria-hidden="true"><div class="scr"><div class="s-bar"><b>Assets</b></div><div class="s-card"><small class="lb">Assets held</small><b class="am">UGX 18,500,000</b><span class="dim">2 assets · valued at what each cost</span></div><div class="s-as"><span class="kt" style="--k:#E3A82B"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 19l6-9 4 5 3-4 5 8z"/></svg></span><div class="ib"><div class="n1"><b>Plot in Wakiso</b><em class="chip">Held</em></div><b class="am">UGX 15,000,000</b><div class="gold">UGX 3,000,000 still owing · due 30 Nov</div><div class="dim sm">Home · Land · Bought 4 Aug</div></div></div><div class="s-as"><span class="kt" style="--k:#E3A82B"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="16" r="3"/><circle cx="18" cy="16" r="3"/><path d="M6 16l4-6h4l4 6M13 10l-1-3h-2"/></svg></span><div class="ib"><div class="n1"><b>Boda-boda</b><em class="chip">Held</em></div><b class="am">UGX 3,500,000</b><div class="dim sm">Shop · Motorcycle · Bought 2 Sep</div></div></div></div></div><p class="fc-tag">Everyone</p><h3>Assets</h3><p class="fc-line">The land, vehicles and equipment you hold, valued from the records that bought them.</p></li><li class="fc"><div class="fc-ui" aria-hidden="true"><div class="scr"><div class="s-bar"><b>Register</b></div><div class="s-card s-row"><small class="dim">Group savings</small><b class="fig">UGX 1,560,000</b></div><div class="s-reg"><span class="face ph ph-sarah">SA</span><div class="ib"><div class="n1"><b>Sarah</b><span class="fig"><small>UGX </small>350,000</span></div><div class="sm"><span class="in">+ UGX 50,000</span> · 12 Oct</div></div></div><div class="s-reg"><span class="face ph ph-grace">GR</span><div class="ib"><div class="n1"><b>Grace</b><span class="fig"><small>UGX </small>420,000</span></div><div class="sm"><span class="in">+ UGX 50,000</span> · 10 Oct</div></div></div><div class="s-reg"><span class="face ph ph-ruth">RU</span><div class="ib"><div class="n1"><b>Ruth</b><span class="fig"><small>UGX </small>280,000</span></div><div class="sm gold"><b>+ UGX 50,000 · their own record · confirm</b></div></div></div></div></div><p class="fc-tag">Savings groups</p><h3>Register and passbook</h3><p class="fc-line">The group keeps the register. Each member keeps a passbook of their own.</p></li><li class="fc"><div class="fc-ui" aria-hidden="true"><div class="scr"><div class="s-bar"><b>Round</b></div><div class="s-rname">Kisaasi Round</div><div class="s-cyc"><svg class="ic dim"><use href="#i-cl"/></svg><span>DUE FRI 30 OCT · CYCLE 2 OF 6</span><svg class="ic dim"><use href="#i-cr"/></svg></div><div class="s-cc"><b class="cw">Collecting for Grace</b><div class="meta">Paid in UGX 300,000 of 600,000</div><div class="dim sm">Pot holds 300,000</div><div class="cbar"><i style="width:50%"></i></div><div class="rk">STILL TO PAY · 3</div><div class="seat"><span class="disc">PE</span><span class="nm">Peter</span><span class="sr"><b>100,000</b><small>To pay</small></span></div><div class="seat"><span class="disc">DA</span><span class="nm">Daniel</span><span class="sr"><b>100,000</b><small>To pay</small></span></div><div class="rk">PAID · 2</div><div class="seat"><span class="disc">RU</span><span class="nm">Ruth</span><span class="sr"><b class="in">100,000</b><small class="in">Paid</small></span></div></div></div></div><p class="fc-tag">Cash round groups</p><h3>Cash round</h3><p class="fc-line">The group's own account runs the round: who has paid in, who still has to, and whose turn it is.</p></li></ul>
  <div class="fd-foot"><p class="fd-rest">These are the first tools in the app. More are on the way, for each kind of relationship.</p><TLink href="/how-it-works" label="See how it works" /></div>
</div></section>
<style is:global>
#does .fd-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:clamp(24px,3vw,36px)}
#does .fd-arrows{display:flex;gap:10px}
#does .fd-btn{width:48px;height:48px;border-radius:50%;border:1px solid var(--line);background:var(--panel);color:var(--ink);font:500 26px/1 var(--display);cursor:pointer}
#does .fd-btn:hover{border-color:rgba(227,168,43,.5)}
@media (max-width:700px){#does .fd-arrows{display:none}}
#does .fd-rail{list-style:none;margin:0 calc(-1*max(16px,(100vw - 1148px)/2));padding:4px max(16px,(100vw - 1148px)/2) 18px;display:grid;grid-auto-flow:column;grid-auto-columns:min(300px,78vw);gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:max(16px,(100vw - 1148px)/2);scrollbar-width:thin}
#does .fc{scroll-snap-align:start;display:flex;flex-direction:column;gap:8px;padding:22px;border-radius:20px;border:1px solid var(--line);background:linear-gradient(160deg,var(--panel),rgba(17,35,79,.45))}
#does .fc-tag{font:600 11.5px/1 var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
#does .fc h3{font:700 22px/1.15 var(--display);letter-spacing:-.02em;color:var(--ink)}
#does .fc-line{color:var(--dim);font-size:15px;line-height:1.5;min-height:4.5em}
#does .fc-ui{margin-top:auto;padding:12px;border-radius:14px;background:#0F1219;border:1px solid rgba(237,232,222,.07);display:grid;gap:8px;font-size:12.5px}
#does .fc-ui em{font-style:normal;font-size:10px;padding:2px 6px;margin-left:6px;border-radius:99px;background:rgba(237,232,222,.08);color:var(--dim)}
#does .fd-foot{margin-top:clamp(16px,2vw,24px)}
#does{border-top:1px solid var(--line)}
#does .fc-ui{margin-top:0;margin-bottom:10px;height:214px;align-content:start;overflow:hidden}
#does .fc-line{min-height:0}
#does .fd-foot{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px}
#does .fd-rest{color:var(--dim);font-size:16px;max-width:34em}
/* real app elements, drawn at the app's own sizes and scaled into the card */
#does .fc-ui{height:244px;padding:0;background:#0F1219;overflow:hidden;position:relative}
#does .fc-ui::after{content:"";position:absolute;inset:auto 0 0;height:40px;background:linear-gradient(transparent,#0F1219)}
#does .scr{width:390px;zoom:.655;color:#EDE8DE;font:400 15px/1.3 var(--body);--dim:#A3ABBE;--line:rgba(237,232,222,.09);--gold:#E3A82B;--in:#63C08B;--out:#E4795F;--clay:#E4795F;--well:#1B2130;--card:#171C27}
#does .scr *{box-sizing:border-box}
#does .scr .ic{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2;vertical-align:-2px;flex:none}
#does .scr .ic.gold{color:var(--gold)} #does .scr .ic.dim{color:var(--dim)} #does .scr .ic.in{color:var(--in)} #does .scr .ic.out{color:var(--out)}
#does .scr .in{color:var(--in)} #does .scr .out{color:var(--out)} #does .scr .gold{color:var(--gold)} #does .scr .dim{color:var(--dim)} #does .scr .sm{font-size:13px}
#does .s-bar{height:52px;display:flex;align-items:center;padding:0 16px;border-bottom:1px solid var(--line)} #does .s-bar b{font:800 18px/1 var(--display)}
#does .s-band{height:36px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;background:#141925;font:700 13px/1 var(--body);letter-spacing:.07em;color:var(--dim)} #does .s-band em{font-style:normal;letter-spacing:0;font-weight:600;margin-left:8px}
#does .s-led{display:grid;grid-template-columns:48px 1fr;gap:12px;padding:12px 16px;border-bottom:1px solid var(--line)}
#does .s-led .dg{text-align:center} #does .s-led .dg b{display:block;font:600 15px/1.1 var(--body)} #does .s-led .dg small{font:700 12px/1 var(--body);letter-spacing:.06em;color:var(--dim)}
#does .l1{display:flex;justify-content:space-between;gap:8px;align-items:baseline} #does .tt{font:600 17px/1.25 var(--body);display:inline-flex;gap:4px;align-items:center} #does .tt .ic{width:14px;height:14px;fill:var(--gold);stroke:none}
#does .amt{font:700 16px/1 var(--body);font-variant-numeric:tabular-nums;white-space:nowrap} #does .amt .ic{width:14px;height:14px}
#does .l2{color:var(--dim);margin-top:3px;display:flex;flex-wrap:wrap;gap:4px;align-items:center}
#does .pill{display:inline-flex;gap:4px;align-items:center;padding:3px 8px;border-radius:99px;border:1px solid var(--line);font:500 11.5px/1 var(--body);color:var(--dim);margin-left:auto}
#does .s-chips{display:flex;gap:8px;padding:10px 16px} #does .s-chips span{height:36px;display:inline-flex;align-items:center;padding:0 13px;border-radius:99px;border:1px solid var(--line);font:600 15px/1 var(--body);color:var(--dim);background:var(--card)} #does .s-chips .on{background:var(--gold);border-color:var(--gold);color:#0F2557}
#does .s-inb,#does .s-sp,#does .s-pr,#does .s-reg{display:flex;gap:12px;align-items:center;padding:11px 16px;border-bottom:1px solid var(--line)}
#does .face{width:52px;height:52px;flex:none;border-radius:50%;background:#EDE8DE center/cover;color:#0F2557;display:grid;place-items:center;font:700 17px/1 var(--body)} #does .face.sq{border-radius:12px;background:#EAA57E}
#does .ib{flex:1;min-width:0} #does .n1{display:flex;align-items:center;gap:6px} #does .n1 b{font:600 17px/1.25 var(--body)} #does .n1 time{margin-left:auto;font-size:14px;color:var(--dim)} #does .n1 time.gold{color:var(--gold)}
#does .unread .n1 b{font-weight:700} #does .dot{width:9px;height:9px;border-radius:50%;background:var(--gold);flex:none}
#does .n2{display:flex;align-items:center;gap:6px;margin-top:2px;color:var(--dim);white-space:nowrap} #does .n2 .amt{font:600 15px/1 var(--body);color:#EDE8DE} #does .n2 .amt.out{color:var(--out)} #does .n2 .ic.gold{fill:var(--gold);stroke:none}
#does .badge{margin-left:auto;min-width:18px;height:18px;border-radius:99px;background:var(--gold);color:#0F2557;font:600 11px/18px var(--body);text-align:center;padding:0 5px}
#does .s-tabs{display:flex;gap:18px;padding:0 16px;border-bottom:1px solid var(--line)} #does .s-tabs span{padding:12px 0;font:600 14px/1 var(--body);color:var(--dim)} #does .s-tabs .on{color:#EDE8DE;box-shadow:inset 0 -2px var(--gold)}
#does .s-head{display:flex;justify-content:space-between;align-items:center;padding:14px 16px 6px;font:700 13px/1 var(--body);letter-spacing:.07em;color:var(--dim)} #does .s-head em{font-style:normal;letter-spacing:0;color:var(--gold);font-weight:600;display:inline-flex;gap:4px;align-items:center}
#does .fold{position:relative;width:52px;height:52px;flex:none} #does .fold i{position:absolute;inset:6px 2px 4px;border-radius:8px;background:var(--t)} #does .fold i::before{content:"";position:absolute;left:0;top:-5px;width:22px;height:8px;border-radius:4px 4px 0 0;background:var(--t)} #does .fold b{position:absolute;inset:0;display:grid;place-items:center;font:700 16px/1 var(--body);color:#0F2557}
#does .s-strip{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:12px 16px 4px} #does .s-strip>div{background:var(--card);border-radius:18px;padding:14px;display:grid;gap:3px} #does .s-strip small{font-size:14px;color:var(--dim)} #does .s-strip b{font:700 19px/1.2 var(--body)} #does .s-strip span{font-size:13px;color:var(--dim)}
#does .s-cap{padding:4px 16px 6px;font-size:14px;color:var(--dim)}
#does .s-pr .ib b{font:600 17px/1.25 var(--body)} #does .nr{text-align:right;display:grid;gap:2px} #does .nr b{font:700 16px/1 var(--body)} #does .nr small{font-size:14px}
#does .s-card{margin:12px 16px 0;background:var(--card);border-radius:18px;padding:16px;display:grid;gap:4px} #does .s-card .sh{font:700 13px/1 var(--body);letter-spacing:.07em;color:var(--dim)} #does .disp{font:700 28px/1.15 var(--display)} #does .s-card .lb{font:700 12px/1 var(--body);letter-spacing:.05em;color:var(--dim)}
#does .s-accr{display:flex;align-items:center;gap:12px;padding:12px} #does .s-accr .ib{display:grid;gap:2px} #does .s-accr .ib b{font:600 17px/1.2 var(--body)} #does .s-accr .ib span{font-size:14px}
#does .kt{width:40px;height:40px;flex:none;border-radius:12px;display:grid;place-items:center;font-size:20px;color:var(--k);background:color-mix(in srgb,var(--k) 18%,transparent)}
#does .s-as{display:flex;gap:12px;padding:12px 16px;border-bottom:1px solid var(--line)} #does .s-as .kt{width:44px;height:44px} #does .am{font:700 16px/1.3 var(--body)} #does .chip{margin-left:auto;font:600 13px/1 var(--body);font-style:normal;padding:4px 8px;border-radius:12px;background:var(--well);color:var(--gold)}
#does .s-row{display:flex;justify-content:space-between;align-items:center;padding:14px 16px} #does .fig{font:700 19px/1 var(--body)} #does .fig small{font:400 12px/1 var(--body);color:var(--dim)} #does .s-reg{min-height:74px} #does .s-reg .n1 .fig{margin-left:auto}
#does .s-rname{height:52px;display:grid;place-items:center;font:800 18px/1 var(--display);border-bottom:1px solid var(--line)}
#does .s-cyc{height:44px;display:flex;align-items:center;justify-content:space-between;padding:0 12px;font:700 11px/1 var(--body);letter-spacing:.08em;color:var(--dim)} #does .s-cyc .ic{width:24px;height:24px}
#does .s-cc{margin:0 16px;border-radius:20px;background:var(--card);padding:16px} #does .cw{font:700 20px/1.2 var(--display)} #does .meta{font-size:12px;color:var(--dim);margin-top:4px}
#does .cbar{height:6px;border-radius:9px;background:var(--well);margin:10px 0} #does .cbar i{display:block;height:100%;border-radius:9px;background:var(--gold)}
#does .rk{font:700 11px/1 var(--body);letter-spacing:.08em;color:var(--dim);margin:10px 0 2px} #does .seat{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--line)} #does .disc{width:34px;height:34px;border-radius:50%;background:var(--well);display:grid;place-items:center;font:700 12px/1 var(--body);color:var(--dim)} #does .nm{flex:1;font-size:13.5px} #does .sr{text-align:right;display:grid} #does .sr b{font:700 14px/1.1 var(--body)} #does .sr small{font:600 11.5px/1.2 var(--body);color:var(--dim)} #does .sr small.in{color:var(--in)}
#does .fd-rail{grid-auto-columns:min(320px,80vw)}
/* where the page's question rail shows, the cards stop at the column edge so they never run under it */
@media (min-width:1360px){#does .fd-rail{margin-right:0;padding-right:0}}
</style>
<script>
document.querySelectorAll<HTMLButtonElement>('#does .fd-btn').forEach(function(b){b.addEventListener('click',function(){var r=document.querySelector<HTMLElement>('#does .fd-rail'),c=r&&r.querySelector<HTMLElement>('.fc');if(r&&c)r.scrollBy({left:Number(b.dataset.d)*(c.offsetWidth+16),behavior:'smooth'})})});
</script>
