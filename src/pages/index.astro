<script>
(function(){
  requestAnimationFrame(function(){drawThread()});

  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var stage=document.getElementById('stage');
  function drawThread(){
    var ta=document.getElementById('tieA'),tb=document.getElementById('tieB'),svg=document.getElementById('thread');
    if(!ta||!tb||!ta.offsetParent)return;
    var s=stage.getBoundingClientRect();
    function mid(el){var r=el.getBoundingClientRect();return [r.left+r.width/2,r.top+r.height/2]}
    var a=mid(ta),b=mid(tb);
    /* drawn only where both ends can be seen on their own phone: an end under the other phone or off the page reads as a line to nowhere */
    function seen(p,el){
      if(p[0]<0||p[0]>innerWidth||p[1]<0||p[1]>innerHeight)return true;
      var top=document.elementFromPoint(p[0],p[1]);
      return !!top&&el.closest('.phone').contains(top);
    }
    var vis=stage.classList.contains('sealed')?(seen(a,ta)&&seen(b,tb)):true;
    if(window.matchMedia('(max-width:700px)').matches)vis=false;
    svg.classList.toggle('off',!vis);
    var x1=a[0]-s.left,y1=a[1]-s.top,x2=b[0]-s.left,y2=b[1]-s.top,dx=Math.max(24,Math.abs(x2-x1)*.6);
    document.getElementById('threadPath').setAttribute('d','M'+x1+' '+y1+' C'+(x1+dx)+' '+y1+' '+(x2-dx)+' '+y2+' '+x2+' '+y2);
    var A=document.getElementById('tA'),B=document.getElementById('tB');
    A.setAttribute('cx',x1);A.setAttribute('cy',y1);B.setAttribute('cx',x2);B.setAttribute('cy',y2);
  }
  window.addEventListener('resize',drawThread);
  var tq=0;window.addEventListener('scroll',function(){if(!tq){tq=1;requestAnimationFrame(function(){tq=0;drawThread()})}},{passive:true});
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(drawThread);
  setTimeout(drawThread,300);

  var rungs=stage.querySelectorAll('.rung');
  function setRungs(n){rungs.forEach(function(r,i){r.classList.toggle('done',i<n)})}
  setRungs(3);
  if(!reduce){
    var btn=document.getElementById('confirmBtn'),t=[],on=false,paused=false,pb=document.getElementById('hpause');
    /* wait, sheet up, press Confirm, sealed, hold, then again; it stops while the hero is off screen */
    function clr(){t.forEach(clearTimeout);t=[]}
    function cycle(){
      clr();
      stage.classList.remove('sealed','sheet-up');btn.classList.remove('press');setRungs(1);
      t.push(setTimeout(function(){stage.classList.add('sheet-up')},1600));
      t.push(setTimeout(function(){btn.classList.add('press')},3200));
      t.push(setTimeout(function(){btn.classList.remove('press');stage.classList.remove('sheet-up');setRungs(2)},3600));
      t.push(setTimeout(function(){stage.classList.add('sealed');setRungs(3);drawThread()},4300));
      t.push(setTimeout(cycle,7500));
    }
    function rest(){clr();btn.classList.remove('press');stage.classList.remove('sheet-up');stage.classList.add('sealed');setRungs(3);drawThread()}
    if('IntersectionObserver' in window){
      new IntersectionObserver(function(es){var v=es[0].isIntersecting;if(v&&!on){on=true;if(!paused)cycle()}else if(!v&&on){on=false;rest()}},{threshold:.25}).observe(stage);
    }else{setTimeout(cycle,2600)}
    if(pb){pb.hidden=false;pb.addEventListener('click',function(){
      paused=!paused;pb.classList.toggle('is-paused',paused);pb.setAttribute('aria-label',paused?'Play animation':'Pause animation');
      if(paused)rest();else if(on)cycle()})}
  }

})();
</script>
<script>
(function(){
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  /* how it works: copy each step's screen into the sticky phone, show the one being read */
  var hs=document.getElementById('howScreen'),steps=document.querySelectorAll('.hstep'),dots=document.querySelectorAll('.how-dots li');
  if(hs){
    steps.forEach(function(s,i){var a=s.querySelector('.hscreen>.app');if(a){var c=a.cloneNode(true);if(i===0)c.classList.add('on');hs.appendChild(c)}});
    var layers=hs.children;
    function act(n){for(var i=0;i<layers.length;i++)layers[i].classList.toggle('on',i===n);dots.forEach(function(d,i){d.classList.toggle('on',i===n)})}
    /* one rule: the active step is the last whose top has passed 40% of the screen; step 1 until then, step 4 until the section ends.
       Only the wide layout has the pinned phone, so nothing switches where each step carries its own phone. */
    var hcur=-1,hq=0;
    function hpick(){hq=0;if(!hs.offsetParent)return;var line=innerHeight*.4,n=0;
      for(var i=0;i<steps.length;i++){if(steps[i].getBoundingClientRect().top<=line)n=i}
      if(n!==hcur){hcur=n;act(n)}}
    window.addEventListener('scroll',function(){if(!hq){hq=1;requestAnimationFrame(hpick)}},{passive:true});
    window.addEventListener('resize',hpick);hpick();
  }
  /* is it for me: on a wide screen the pinned phone shows the door being read */
  var blks=[].slice.call(document.querySelectorAll('.fm3-blk')),scrs=[].slice.call(document.querySelectorAll('.fm3-scr')),sums=[].slice.call(document.querySelectorAll('.fm3-sum')),flab=document.getElementById('fm3Lab'),labs={"you":"Sarah’s phone · Grace","grp":"Kisaasi Savers · Register","biz":"Mukasa Traders’ phone · Sarah"};
  var fdev=document.querySelector('.fm3-dev');
  function fsize(k){if(!fdev)return;var sc=fdev.querySelector('.fm3-scr[data-k="'+k+'"] .app');if(sc&&sc.offsetHeight)fdev.style.height=(sc.offsetHeight+46)+'px'}
  function fshow(k){fsize(k);blks.forEach(function(b){b.classList.toggle('on',b.dataset.k===k)});scrs.forEach(function(s){s.classList.toggle('on',s.dataset.k===k)});sums.forEach(function(s){s.classList.toggle('on',s.dataset.k===k)});if(flab)flab.textContent=labs[k]}
  /* a door holds the phone until the next door's heading crosses the middle of the screen */
  var fcurK=null,fq=0;
  function fpick(){fq=0;if(!blks.length)return;var mid=innerHeight/2,k=blks[0].dataset.k;blks.forEach(function(b){var h=b.querySelector('.fm3-hd')||b;if(h.getBoundingClientRect().top<=mid)k=b.dataset.k});if(k!==fcurK){fcurK=k;fshow(k)}}
  window.addEventListener('scroll',function(){if(!fq){fq=1;requestAnimationFrame(fpick)}},{passive:true});window.addEventListener('resize',fpick);fpick();
})();
</script>
