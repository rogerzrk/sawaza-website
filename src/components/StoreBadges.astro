---
/* The Google Play and App Store badges. Until the apps are listed the store links are
   placeholders, so the badges point at the page's own get section instead. */
import { STORE_PLAY_URL, STORE_APPLE_URL } from '../config';
interface Props {
  class?: string;
}
const { class: extra } = Astro.props;
const play = STORE_PLAY_URL === '#' ? '#get' : STORE_PLAY_URL;
const apple = STORE_APPLE_URL === '#' ? '#get' : STORE_APPLE_URL;
---
<div class={extra ? `badges ${extra}` : 'badges'}>
    <a class="badge" href={play}><svg viewBox="0 0 26 26" aria-hidden="true"><path d="M4 3l12 10L4 23z" fill="#34A853"/><path d="M4 3l15 8.5-3 1.5z" fill="#4285F4"/><path d="M4 23l15-8.5-3-1.5z" fill="#EA4335"/><path d="M19 11.5l3 1.5-3 1.5-3-1.5z" fill="#FBBC04"/></svg><span><small>Get it on</small><b>Google Play</b></span></a>
    <a class="badge" href={apple}><svg viewBox="0 0 26 26" aria-hidden="true"><path d="M17.5 13.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.2-2.8.8-3.5.8s-1.8-.8-3-.8c-1.5 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.3 0 2.1-1.1 2.8-2.3.9-1.3 1.3-2.6 1.3-2.6s-2.5-1-2.5-3.7zM15.3 6.8c.6-.8 1.1-1.8 1-2.9-.9 0-2 .6-2.7 1.4-.6.7-1.1 1.8-1 2.8 1 .1 2-.5 2.7-1.3z" fill="#fff"/></svg><span><small>Download on the</small><b>App Store</b></span></a>
  </div>
