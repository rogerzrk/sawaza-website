---
/* The Sawaza mark alone: faint behind a page hero ("watermark"), small above the close section
   ("mark"), or in gold at app size inside a notification or a record ("gold"). */
interface Props {
  class?: string;
  gold?: boolean;
}
const { class: cls = '', gold = false } = Astro.props;
